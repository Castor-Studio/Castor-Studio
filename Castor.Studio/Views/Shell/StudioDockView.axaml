<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Shell"
             x:Class="CastorApplication.Views.Shell.StudioDockView"
             x:DataType="vm:StudioDockViewModel">

	<!-- The dockable space is the only page keeping a margin: it detaches panels
	     from the edges so they read as floating panels. -->
	<DockControl Layout="{Binding Layout}" Background="{DynamicResource AppBg}" Margin="12"/>

</UserControl>
