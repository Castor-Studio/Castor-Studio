<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Shell"
             x:Class="CastorApplication.Views.Shell.StudioDockView"
             x:DataType="vm:StudioDockViewModel">

	<!-- L'espace ancrable est la seule page qui garde une marge : elle détache les panneaux
	     des bords pour qu'ils se lisent comme des panneaux flottants. -->
	<DockControl Layout="{Binding Layout}" Background="{DynamicResource AppBg}" Margin="12"/>

</UserControl>
