<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             x:Class="CastorApplication.Views.MulticamView"
             x:DataType="vm:MulticamViewModel">

	<!-- Same inset as the Studio's dockable space: the page carries its own margin,
	     the shell no longer applies it. AI errors show in its panel,
	     which follows the operator if moved out of the window.

	     The page is a dockable space: the display and AI settings are two
	     panels that can be moved or taken out. -->
	<DockControl Layout="{Binding DockLayout}"
	             Background="{DynamicResource AppBg}" Margin="12"/>

</UserControl>
