<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             x:Class="CastorApplication.Views.MulticamView"
             x:DataType="vm:MulticamViewModel">

	<!-- Même inset que l'espace ancrable du Studio : la page porte elle-même sa marge,
	     la coquille ne l'applique plus. Les erreurs de l'IA s'affichent dans son panneau,
	     qui suit l'opérateur s'il le sort de la fenêtre.

	     La page est un espace ancrable : l'affichage et les réglages de l'IA sont deux
	     panneaux, qu'on peut déplacer ou sortir. -->
	<DockControl Layout="{Binding DockLayout}"
	             Background="{DynamicResource AppBg}" Margin="12"/>

</UserControl>
