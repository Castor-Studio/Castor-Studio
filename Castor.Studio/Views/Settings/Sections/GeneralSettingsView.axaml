<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Settings.Sections"
             x:Class="CastorApplication.Views.Settings.Sections.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">

    <StackPanel Margin="33,24"
                Spacing="28">

        <StackPanel Spacing="14">

            <TextBlock Text="GÉNÉRAL"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">
                <TextBlock Grid.Column="0"
                           Text="Thème"
                           Classes="setting-label"/>

                <ComboBox Grid.Column="1"
                          MaxWidth="260"
                          HorizontalAlignment="Left"
                          SelectedIndex="{Binding SelectedThemeIndex}">

                    <ComboBoxItem Content="Sombre"/>
                    <ComboBoxItem Content="Clair"/>

                </ComboBox>
            </Grid>

            <Grid ColumnDefinitions="211,*">
                <TextBlock Grid.Column="0"
                           Text="Docks"
                           Classes="setting-label"/>

                <CheckBox Grid.Column="1"
                          Content="Afficher le nom des docks"
                          IsChecked="{Binding ShowDockTitles}"
                          Foreground="{DynamicResource AppFg2}"
                          FontSize="13"/>
            </Grid>

            <Rectangle Height="1"
                       Fill="{DynamicResource AppBorder}"
                       Margin="0,4"/>

            <Border Background="{DynamicResource AppSurface3}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,16">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <Image Grid.Column="0" Width="38" Height="38" Source="/Assets/Brand/castor-logo.png"/>

                    <StackPanel Grid.Column="1"
                                Spacing="4">

                        <TextBlock Text="Castor Studio"
                                   Foreground="{DynamicResource AppFg1}"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Libérez le flot de vos événements"
                                   Foreground="{DynamicResource AppFg5}"
                                   FontSize="12.5"
                                   FontStyle="Italic"/>
                    </StackPanel>

                </Grid>

            </Border>

        </StackPanel>

    </StackPanel>

</UserControl>