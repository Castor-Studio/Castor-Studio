<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Settings.Sections"
             x:Class="CastorApplication.Views.Settings.Sections.AdvancedSettingsView"
             x:DataType="vm:AdvancedSettingsViewModel">

    <StackPanel Margin="33,24"
                Spacing="28">

        <StackPanel Spacing="14">

            <TextBlock Text="AVANCÉ"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">
                <TextBlock Grid.Column="0"
                           Text="Processeur de l'IA"
                           Classes="setting-label"/>

                <ComboBox Grid.Column="1"
                          MaxWidth="260"
                          HorizontalAlignment="Left"
                          SelectedIndex="{Binding SelectedAiDeviceIndex}">

                    <ComboBoxItem Content="Automatique (recommandé)"/>
                    <ComboBoxItem Content="CPU"/>
                    <ComboBoxItem Content="GPU"/>

                </ComboBox>
            </Grid>

            <TextBlock Text="Automatique utilise le GPU et passe sur le CPU s'il est trop lent. S'applique au prochain démarrage de l'IA."
                       Foreground="{DynamicResource AppFg4}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <Rectangle Height="1"
                       Fill="{DynamicResource AppBorder}"
                       Margin="0,4"/>

            <!-- Logs and crash reports: what a tester attaches to a bug report. -->
            <Grid ColumnDefinitions="211,*">
                <TextBlock Grid.Column="0"
                           Text="Journaux"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1"
                            Spacing="6">
                    <Button Content="Ouvrir le dossier des journaux"
                            Command="{Binding OpenLogsFolderCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            CornerRadius="5"
                            Cursor="Hand"
                            FontSize="12"
                            Background="{DynamicResource AppSurface2}"
                            BorderBrush="{DynamicResource AppBorder2}"
                            BorderThickness="1"
                            Foreground="{DynamicResource AppFg2}"/>
                    <SelectableTextBlock Text="{Binding LogsDirectory}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource AppFg4}"
                                         FontSize="11"/>
                </StackPanel>
            </Grid>

        </StackPanel>

    </StackPanel>

</UserControl>
