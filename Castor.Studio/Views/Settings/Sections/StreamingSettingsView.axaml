<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Settings.Sections"
             xmlns:converters="using:CastorApplication.Converters"
             x:Class="CastorApplication.Views.Settings.Sections.StreamingSettingsView"
             x:DataType="vm:StreamingSettingsViewModel">

    <StackPanel Margin="33,24"
                Spacing="28">

        <StackPanel Spacing="14">

            <TextBlock Text="STREAMING"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Destination"
                           Classes="setting-label top"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <!-- A choice only with two connected accounts; otherwise the one used, or how to get one.
                         Every ticked platform goes live at once; the last one ticked stays ticked. -->
                    <StackPanel Spacing="4"
                                IsVisible="{Binding CanChooseDestination}">
                        <ItemsControl ItemsSource="{Binding Destinations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <!-- Logo, platform and account, as on Settings › Comptes. -->
                                <DataTemplate x:DataType="vm:StreamingDestinationOption">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding CanToggle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4"
                                                    Width="20"
                                                    Height="20"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding ProviderId, Converter={x:Static converters:PlatformLogoConverter.Instance}}"
                                                       Width="20"
                                                       Height="20"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding PlatformName}"
                                                       Foreground="{DynamicResource AppFg2}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AccountName}"
                                                       Foreground="{DynamicResource AppFg4}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DestinationHint}"
                                   Foreground="{DynamicResource AppFg4}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DestinationSummary}"
                               IsVisible="{Binding !CanChooseDestination}"
                               Foreground="{DynamicResource AppFg2}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Les comptes se configurent dans Paramètres → Comptes."
                               Foreground="{DynamicResource AppFg4}"
                               FontSize="11"/>
                </StackPanel>

            </Grid>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Débit stream (kbps)"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left">

                    <Slider Minimum="500"
                            Maximum="10000"
                            Width="220"
                            VerticalAlignment="Center"
                            Value="{Binding StreamingBitrate}"/>

                    <TextBlock Width="50"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource AppFg4}"
                               Text="{Binding StreamingBitrateDisplay}"/>

                </StackPanel>

            </Grid>

            <!-- Given to every platform at each live start: Twitch's channel title, YouTube's broadcast. -->
            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Titre du live"
                           Classes="setting-label top"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBox MinWidth="320"
                             MaxWidth="460"
                             MaxLength="{Binding LiveTitleMaxLength}"
                             HorizontalAlignment="Left"
                             Background="{DynamicResource AppSurface2}"
                             BorderBrush="{DynamicResource AppBorder2}"
                             Foreground="{DynamicResource AppFg2}"
                             PlaceholderText="Live Castor Studio"
                             Text="{Binding LiveTitle}"/>
                    <TextBlock Text="Le même sur chaque plateforme, appliqué au démarrage du live."
                               Foreground="{DynamicResource AppFg4}"
                               FontSize="11"/>
                </StackPanel>

            </Grid>

        </StackPanel>

        <!-- Each YouTube live is a broadcast of its own, created when the live starts. Twitch has
             no description of a live. -->
        <StackPanel Spacing="14"
                    IsVisible="{Binding IsYouTubeConnected}">

            <TextBlock Text="YOUTUBE"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Description"
                           Classes="setting-label top"/>

                <TextBox Grid.Column="1"
                         MinWidth="320"
                         MaxWidth="460"
                         MinHeight="72"
                         MaxHeight="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="{Binding LiveDescriptionMaxLength}"
                         HorizontalAlignment="Left"
                         Background="{DynamicResource AppSurface2}"
                         BorderBrush="{DynamicResource AppBorder2}"
                         Foreground="{DynamicResource AppFg2}"
                         PlaceholderText="Facultative"
                         Text="{Binding LiveDescription}"/>

            </Grid>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Visibilité"
                           Classes="setting-label top"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <ComboBox MaxWidth="260"
                              MinWidth="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding PrivacyOptions}"
                              SelectedItem="{Binding SelectedPrivacy}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:YouTubePrivacyOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Appliquées au prochain live : un live en cours garde les siennes."
                               Foreground="{DynamicResource AppFg4}"
                               FontSize="11"/>
                </StackPanel>

            </Grid>

        </StackPanel>

    </StackPanel>

</UserControl>
