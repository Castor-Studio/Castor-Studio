<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Settings.Sections"
             x:Class="CastorApplication.Views.Settings.Sections.StreamingSettingsView"
             x:DataType="vm:StreamingSettingsViewModel">

    <StackPanel Margin="33,24"
                Spacing="28">

        <StackPanel Spacing="14">

            <TextBlock Text="STREAMING"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Destination"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Twitch"
                               Foreground="{DynamicResource AppFg2}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Le compte utilisé se configure dans Paramètres → Comptes."
                               Foreground="{DynamicResource AppFg4}"
                               FontSize="11"/>
                </StackPanel>

            </Grid>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Débit stream (kbps)"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left">

                    <Slider Minimum="500"
                            Maximum="10000"
                            Width="220"
                            VerticalAlignment="Center"
                            Value="{Binding StreamingBitrate}"/>

                    <TextBlock Width="50"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource AppFg4}"
                               Text="{Binding StreamingBitrateDisplay}"/>

                </StackPanel>

            </Grid>

        </StackPanel>

    </StackPanel>

</UserControl>
