<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Settings.Sections"
             x:Class="CastorApplication.Views.Settings.Sections.StreamingSettingsView"
             x:DataType="vm:StreamingSettingsViewModel">

    <StackPanel Margin="33,24"
                Spacing="28">

        <StackPanel Spacing="14">

            <TextBlock Text="STREAMING"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Destination"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <!-- A choice only with two connected accounts; otherwise the one used, or how to get one.
                         Every ticked platform goes live at once; the last one ticked stays ticked. -->
                    <StackPanel Spacing="4"
                                IsVisible="{Binding CanChooseDestination}">
                        <ItemsControl ItemsSource="{Binding Destinations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StreamingDestinationOption">
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding CanToggle}"
                                              Foreground="{DynamicResource AppFg2}"
                                              FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Le live part en même temps sur chaque plateforme cochée."
                                   Foreground="{DynamicResource AppFg4}"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding MultistreamHint}"
                                   IsVisible="{Binding HasMultistreamHint}"
                                   Foreground="{DynamicResource AppFg4}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DestinationSummary}"
                               IsVisible="{Binding !CanChooseDestination}"
                               Foreground="{DynamicResource AppFg2}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Les comptes se configurent dans Paramètres → Comptes."
                               Foreground="{DynamicResource AppFg4}"
                               FontSize="11"/>
                </StackPanel>

            </Grid>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Débit stream (kbps)"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left">

                    <Slider Minimum="500"
                            Maximum="10000"
                            Width="220"
                            VerticalAlignment="Center"
                            Value="{Binding StreamingBitrate}"/>

                    <TextBlock Width="50"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource AppFg4}"
                               Text="{Binding StreamingBitrateDisplay}"/>

                </StackPanel>

            </Grid>

        </StackPanel>

        <!-- Each YouTube live is a broadcast of its own, created when the live starts. -->
        <StackPanel Spacing="14"
                    IsVisible="{Binding IsYouTubeConnected}">

            <TextBlock Text="YOUTUBE"
                       Classes="section-title"/>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Titre du live"
                           Classes="setting-label"/>

                <TextBox Grid.Column="1"
                         MinWidth="320"
                         MaxWidth="460"
                         MaxLength="{Binding YouTubeBroadcastTitleMaxLength}"
                         HorizontalAlignment="Left"
                         Background="{DynamicResource AppSurface2}"
                         BorderBrush="{DynamicResource AppBorder2}"
                         Foreground="{DynamicResource AppFg2}"
                         PlaceholderText="Live Castor Studio"
                         Text="{Binding YouTubeBroadcastTitle}"/>

            </Grid>

            <Grid ColumnDefinitions="211,*">

                <TextBlock Grid.Column="0"
                           Text="Visibilité"
                           Classes="setting-label"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <ComboBox MaxWidth="260"
                              MinWidth="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding PrivacyOptions}"
                              SelectedItem="{Binding SelectedPrivacy}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:YouTubePrivacyOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Appliqués au prochain live : un live en cours garde les siens."
                               Foreground="{DynamicResource AppFg4}"
                               FontSize="11"/>
                </StackPanel>

            </Grid>

        </StackPanel>

    </StackPanel>

</UserControl>
