<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:CastorApplication.ViewModels.Settings"
             x:Class="CastorApplication.Views.Settings.Components.SettingsNavItem"
             x:DataType="settings:SettingsSectionItem">

	<!-- Un seul contrôle pour les deux états, pour que la section ouverte réagisse au
	     survol et au clavier comme les autres (styles « settings-nav », Controls.axaml).
	     Un RadioButton plutôt qu'un ToggleButton : cliquer la section déjà ouverte ne la
	     décoche pas, et le groupe dit aux lecteurs d'écran qu'il n'y en a qu'une. -->
	<RadioButton Classes="settings-nav"
	             GroupName="SettingsNavigation"
	             Content="{Binding Title}"
	             IsChecked="{Binding IsSelected, Mode=OneWay}"
	             Command="{Binding SelectCommand}"
	             CommandParameter="{Binding}"/>

</UserControl>
