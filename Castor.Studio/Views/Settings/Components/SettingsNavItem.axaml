<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:CastorApplication.ViewModels.Settings"
             x:Class="CastorApplication.Views.Settings.Components.SettingsNavItem"
             x:DataType="settings:SettingsSectionItem">

	<!-- One control for both states, so the open section reacts to hover and keyboard like the
	     others ("settings-nav" styles, Controls.axaml). A RadioButton rather than a ToggleButton:
	     clicking the open section does not uncheck it, and the group tells screen readers there
	     is only one. -->
	<RadioButton Classes="settings-nav"
	             GroupName="SettingsNavigation"
	             Content="{Binding Title}"
	             IsChecked="{Binding IsSelected, Mode=OneWay}"
	             Command="{Binding SelectCommand}"
	             CommandParameter="{Binding}"/>

</UserControl>
