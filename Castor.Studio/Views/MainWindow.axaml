<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CastorApplication.ViewModels.Shell"
        x:Class="CastorApplication.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Castor Studio"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg1}"
        MinWidth="1024" MinHeight="600"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/Assets/castor.png">

	<Grid RowDefinitions="Auto,48,*">

		<!-- ═══ BARRE DE MENUS ═══ -->
		<Border Grid.Row="0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
			<Menu Background="Transparent" Padding="6,0">
				<MenuItem Header="_Fichier">
					<MenuItem Header="_Paramètres" Command="{Binding ShowSettingsCommand}"/>
					<Separator/>
					<MenuItem Header="_Quitter" Command="{Binding QuitCommand}"/>
				</MenuItem>
				<MenuItem Header="_Affichage">
					<MenuItem Header="_Studio" Command="{Binding ShowStudioCommand}"/>
					<MenuItem Header="_Multicam" Command="{Binding ShowMulticamCommand}"/>
					<MenuItem Header="S_cènes" Command="{Binding ShowScenesCommand}"/>
				</MenuItem>

				<!-- Ramène un panneau du studio à sa place : le seul recours quand l'un d'eux
				     a disparu de la disposition. -->
				<MenuItem Header="_Panneaux" ItemsSource="{Binding PanelMenu}">
					<MenuItem.ItemContainerTheme>
						<ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
							<Setter Property="Header" Value="{Binding Title, DataType=vm:StudioPanelEntry}"/>
							<Setter Property="Command" Value="{Binding Show, DataType=vm:StudioPanelEntry}"/>
						</ControlTheme>
					</MenuItem.ItemContainerTheme>
				</MenuItem>
			</Menu>
		</Border>

		<!-- ═══ NAVBAR ═══ -->
		<Border Grid.Row="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="220,*,220">

				<!-- Logo -->
				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="16,0">
					<Image Height="26" Width="26" Source="/Assets/castor.png"/>
					<TextBlock Text="CASTOR"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppFg1}"
                               VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Navigation tabs -->
				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

					<!-- STUDIO -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="STUDIO"
                                Command="{Binding ShowStudioCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsStudioActive}"
                                Margin="8,0"/>
					</StackPanel>

					<!-- MULTICAM -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="MULTICAM"
                                Command="{Binding ShowMulticamCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsMulticamActive}"
                                Margin="8,0"/>
					</StackPanel>

					<!-- SCENES -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="SCÈNES"
                                Command="{Binding ShowScenesCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsScenesActive}"
                                Margin="8,0"/>
					</StackPanel>

					<!-- PARAMETRES -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="PARAMÈTRES"
                                Command="{Binding ShowSettingsCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsSettingsActive}"
                                Margin="8,0"/>
					</StackPanel>

				</StackPanel>

				<!-- Status + Account -->
				<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="16,0">

					<!-- Badge d'état global : OFFLINE / REC / EN DIRECT -->
					<Border Background="{DynamicResource AppSurface3}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Ellipse Width="7" Height="7" Fill="{Binding GlobalStatusBrush}" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding GlobalStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding GlobalStatusBrush}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

				</StackPanel>

			</Grid>
		</Border>

		<!-- Page content. The margin keeps every page off the window edges; the bars above stay
		     full width, as headers should. -->
		<ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="12"/>

	</Grid>
</Window>
