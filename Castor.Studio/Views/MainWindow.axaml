<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CastorApplication.ViewModels.Shell"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="CastorApplication.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Castor Studio"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg1}"
        MinWidth="1024" MinHeight="600"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        Icon="/Assets/castor.png">

	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding CloseSettingsCommand}"/>
	</Window.KeyBindings>

	<!-- Maximized, Windows pushes the frame past the screen edges: OffScreenMargin pulls the
	     content back so the title bar is not cut off at the top. -->
	<Grid RowDefinitions="32,48,*" Margin="{Binding $parent[Window].OffScreenMargin}">

		<!-- ═══ BARRE DE TITRE + MENUS ═══
		     The menu lives in the title bar, Visual Studio style, instead of a row of its own
		     under the Windows one. The bar background is the drag area (move, double-click to
		     maximize); the menu is marked as user content so its clicks reach it. Avalonia draws
		     the icon + window title on the left and the minimize / maximize / close buttons on
		     the right over this bar: the margins keep the menu clear of both. -->
		<Border Grid.Row="0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="100,0,140,0">
			<Menu Background="Transparent" Padding="2,0" VerticalAlignment="Center"
                  chrome:WindowDecorationProperties.ElementRole="User">
				<!-- Compact top-level entries so they fit the 32px bar, as in a native title bar. -->
				<Menu.Styles>
					<Style Selector="Menu > MenuItem">
						<Setter Property="FontSize" Value="13"/>
						<Setter Property="Padding" Value="8,5"/>
					</Style>
				</Menu.Styles>
				<MenuItem Header="_Fichier">
					<MenuItem Header="_Importer des scènes…" Command="{Binding ImportScenesCommand}"/>
					<MenuItem Header="_Exporter des scènes…" Command="{Binding ExportScenesCommand}"/>
					<Separator/>
					<MenuItem Header="_Paramètres" Command="{Binding ShowSettingsCommand}"/>
					<Separator/>
					<MenuItem Header="_Quitter" Command="{Binding QuitCommand}"/>
				</MenuItem>
				<MenuItem Header="_Affichage">
					<MenuItem Header="_Studio" Command="{Binding ShowStudioCommand}"/>
					<MenuItem Header="_Multicam" Command="{Binding ShowMulticamCommand}"/>
					<MenuItem Header="S_cènes" Command="{Binding ShowScenesCommand}"/>
				</MenuItem>

				<!-- Le recours quand la disposition a perdu ses panneaux : l'action de secours
				     d'abord, et à part, plutôt que noyée dans la liste des panneaux. -->
				<MenuItem Header="_Panneaux">
					<MenuItem Header="_Ramener tous les panneaux à leur place"
                              Command="{Binding RestoreAllPanelsCommand}"/>
					<Separator/>
					<MenuItem Header="_Afficher un panneau" ItemsSource="{Binding PanelMenu}">
						<MenuItem.ItemContainerTheme>
							<ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
								<Setter Property="Header" Value="{Binding Title, DataType=vm:StudioPanelEntry}"/>
								<Setter Property="Command" Value="{Binding Show, DataType=vm:StudioPanelEntry}"/>
							</ControlTheme>
						</MenuItem.ItemContainerTheme>
					</MenuItem>
				</MenuItem>
			</Menu>
			</StackPanel>
		</Border>

		<!-- ═══ NAVBAR ═══ -->
		<Border Grid.Row="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="220,*,220">

				<!-- Logo -->
				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="16,0">
					<Image Height="26" Width="26" Source="/Assets/castor.png"/>
					<TextBlock Text="CASTOR"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppFg1}"
                               VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Navigation tabs -->
				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

					<!-- STUDIO -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="STUDIO"
                                Command="{Binding ShowStudioCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsStudioActive}"
                                Margin="8,0"/>
					</StackPanel>

					<!-- MULTICAM -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="MULTICAM"
                                Command="{Binding ShowMulticamCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsMulticamActive}"
                                Margin="8,0"/>
					</StackPanel>

					<!-- SCENES -->
					<StackPanel Orientation="Vertical">
						<Button Classes="nav" Content="SCÈNES"
                                Command="{Binding ShowScenesCommand}"/>
						<Border Height="2" CornerRadius="1"
                                Background="{DynamicResource AppAccentFg}"
                                IsVisible="{Binding IsScenesActive}"
                                Margin="8,0"/>
					</StackPanel>

				</StackPanel>

				<!-- Status + Account -->
				<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="16,0">

					<!-- Badge d'état global : OFFLINE / REC / EN DIRECT -->
					<Border Background="{DynamicResource AppSurface3}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Ellipse Width="7" Height="7" Fill="{Binding GlobalStatusBrush}" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding GlobalStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding GlobalStatusBrush}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Paramètres : un réglage, pas un espace de travail, donc à part des onglets.
					     Un second clic (ou Échap) ramène à l'espace de travail d'où l'on venait. -->
					<Button Classes="settings-gear"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip.Tip="Paramètres">
						<Viewbox Width="18" Height="18">
							<Canvas Width="24" Height="24">
								<Path Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
							</Canvas>
						</Viewbox>
					</Button>

				</StackPanel>

			</Grid>
		</Border>

		<!-- Page content, edge to edge: a page owns the whole area under the bars, so its own
		     chrome (sidebars, separators) meets the window edges. Only the dock workspaces
		     inset themselves, so their panels keep reading as floating panes. -->
		<ContentControl Grid.Row="2" Content="{Binding CurrentPage}"/>

	</Grid>
</Window>
