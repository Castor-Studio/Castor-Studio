<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:converters="using:CastorApplication.Converters"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Studio.StreamControlsPaneView"
             x:DataType="vm:StudioViewModel">

	<UserControl.Styles>
		<Style Selector="Button.flyout-start">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</UserControl.Styles>

	<!-- Bottom half of the pane card: rounds/outlines the sides + bottom, the dock's title bar does the top (DockTheme.axaml). -->
	<Border x:Name="PaneRoot" Background="{DynamicResource AppSurface}" CornerRadius="0,0,8,8" Padding="10,8"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
		<!-- UniformGrid, not WrapPanel: the two visible buttons share the space equally,
             which centres them by symmetry, lets them shrink together instead of wrapping
             into a second line the slim bottom bar can't fit, and rules out overlap.
             2 columns in landscape, 1 column (stacked) in portrait; Rows=0 = auto. -->
		<UniformGrid VerticalAlignment="Center" Rows="0"
                     Columns="{Binding #PaneRoot.Bounds, Converter={x:Static converters:PortraitColumnsConverter.Instance}}">

			<Button Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                    x:Name="GoLiveButton"
                    Content="LANCER LE LIVE"
                    IsVisible="{Binding !IsStreaming}"
                    IsEnabled="{Binding !IsStreamingTransition}"
                    Classes="ctrl-btn"
                    Background="{DynamicResource AppLiveBg}" Foreground="{DynamicResource StatusOkBrush}"
                    BorderBrush="{DynamicResource AppLiveBorder}">
				<Button.Flyout>
					<Flyout Placement="Top">
						<StackPanel Width="280" Spacing="12" Margin="4"
                                    controls:FlyoutActions.Error="{Binding StreamError.Text}">
							<TextBlock Text="DÉMARRER LE STREAM"
                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
							<Rectangle Height="1" Fill="{DynamicResource AppBorder2}"/>
							<!-- Destination et compte seulement : la scène qui part est déjà dans la barre
							     d'état, et se choisit au sélecteur « Scène active ». -->
							<StackPanel Spacing="4">
								<TextBlock Text="Destination" Foreground="{DynamicResource AppFg3}" FontSize="11"/>
								<TextBlock Text="{Binding DestinationLabel}" Foreground="{DynamicResource AppFg1}"
                                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
							<!-- Compte connecté : son nom, comme avant. Sinon : de quoi le connecter, ici même. -->
							<Border IsVisible="{Binding IsAccountConnected}"
                                    Background="{DynamicResource AppSurface2}" CornerRadius="5" Padding="10,8"
                                    BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="{Binding ConnectedAccountLabel}"
                                               Foreground="{DynamicResource AppFg3}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
							<Button IsVisible="{Binding !IsAccountConnected}"
                                    Command="{Binding OpenAccountSettingsCommand}"
                                    controls:FlyoutActions.CloseOnSuccess="True"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="10,8" CornerRadius="5" Cursor="Hand"
                                    Background="{DynamicResource AppAccentBg}"
                                    BorderBrush="{DynamicResource AppAccentFg}" BorderThickness="1"
                                    Foreground="{DynamicResource AppAccentFg}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Content="Connecter un compte"
                                    ToolTip.Tip="Ouvre Paramètres › Comptes"/>
							<Button Content="DÉMARRER"
                                    Command="{Binding StartStreamingCommand}"
                                    controls:FlyoutActions.CloseOnSuccess="True"
                                    Classes="flyout-start"
                                    Background="{DynamicResource StatusOkBrush}" Foreground="{DynamicResource AppOnStatusFg}"/>
							<TextBlock Text="{Binding StartStreamingBlockedReason}"
                                       IsVisible="{Binding !IsAccountConnected}"
                                       Foreground="{DynamicResource AppFg4}" FontSize="11"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
							<TextBlock Text="{Binding StreamError.Text}"
                                       IsVisible="{Binding StreamError.HasText}"
                                       Foreground="{DynamicResource StatusErrorBrush}" FontSize="11"
                                       TextWrapping="Wrap"/>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<Button Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                    Content="ARRÊTER LE LIVE"
                    IsVisible="{Binding IsStreaming}"
                    IsEnabled="{Binding !IsStreamingTransition}"
                    Command="{Binding StopStreamingCommand}"
                    Classes="ctrl-btn"
                    Background="{DynamicResource AppStopBg}" Foreground="{DynamicResource StatusErrorBrush}"
                    BorderBrush="{DynamicResource AppStopBorder}"/>

			<!-- Un clic, et l'enregistrement part sur la scène active. Le dossier se règle dans
			     Paramètres et se rappelle au survol. -->
			<Button Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                    Content="ENREGISTRER"
                    IsVisible="{Binding !IsRecording}"
                    Command="{Binding StartRecordingCommand}"
                    ToolTip.Tip="{Binding RecordingOutputDirectory, StringFormat='Enregistre la scène active dans : {0}'}"
                    Classes="ctrl-btn"
                    Background="{DynamicResource AppRecBg}" Foreground="{DynamicResource StatusRecBrush}"
                    BorderBrush="{DynamicResource AppRecBorder}"/>

			<Button Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                    Content="ARRÊTER"
                    IsVisible="{Binding IsRecording}"
                    Command="{Binding StopRecordingCommand}"
                    Classes="ctrl-btn"
                    Background="{DynamicResource AppStopBg}" Foreground="{DynamicResource StatusErrorBrush}"
                    BorderBrush="{DynamicResource AppStopBorder}"/>

		</UniformGrid>

		<!-- Plus de panneau avant l'enregistrement, mais un échec doit encore se voir :
		     cette bulle s'ouvre au-dessus des boutons dès que RecordError se remplit
		     (StreamControlsPaneView.axaml.cs). -->
		<FlyoutBase.AttachedFlyout>
			<Flyout Placement="Top">
				<StackPanel Width="280" Spacing="8" Margin="4">
					<TextBlock Text="ENREGISTREMENT"
                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
					<Border Background="{DynamicResource AppErrorBg}" CornerRadius="5" Padding="10,7"
                            BorderBrush="{DynamicResource AppErrorBorder}" BorderThickness="1">
						<TextBlock Text="{Binding RecordError.Text}"
                                   Foreground="{DynamicResource StatusErrorBrush}" FontSize="11" TextWrapping="Wrap"/>
					</Border>
				</StackPanel>
			</Flyout>
		</FlyoutBase.AttachedFlyout>
	</Border>

</UserControl>
