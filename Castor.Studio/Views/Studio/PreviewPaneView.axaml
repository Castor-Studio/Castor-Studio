<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Studio.PreviewPaneView"
             x:DataType="vm:StudioViewModel">

	<!-- Same card as the other panels: the dock bar rounds the top, this border the bottom.
	     In a fullscreen window the card flattens to the bare picture (Styles/DockTheme.axaml). -->
	<Border Classes="preview-card" Background="Black" CornerRadius="0,0,8,8" ClipToBounds="True"
	        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
	<Panel Background="Black">

		<controls:StudioPreview Scene="{Binding ActiveScene}"
                                PreviewRuntime="{Binding PreviewRuntime}"
                                BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                Message="{Binding PreviewPlaceholderText}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

		<!-- Covers StudioPreview when nothing can be shown. StudioPreview has its own internal
		     message for "no scene"/"engine unavailable", but not for "scene with no video source"
		     (ScenesViewModel does not have that case): this panel stays needed for that message,
		     which then covers an empty native render rather than a missing one. -->
		<StackPanel IsVisible="{Binding ShowPreviewPlaceholder}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6">
			<TextBlock Text="APERÇU"
                       Foreground="{DynamicResource VideoFgBrush}"
                       FontSize="13" FontWeight="Bold" LetterSpacing="2"
                       HorizontalAlignment="Center"/>
			<TextBlock Text="{Binding PreviewPlaceholderText}"
                       Foreground="{DynamicResource VideoFgMutedBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" HorizontalAlignment="Center"/>
		</StackPanel>
	</Panel>
	</Border>

</UserControl>
