<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Studio.PreviewPaneView"
             x:DataType="vm:StudioViewModel">

	<!-- Same card as the other panels: the dock bar rounds the top, this border the bottom.
	     In a fullscreen window the card flattens to the bare picture (Styles/DockTheme.axaml). -->
	<Border Classes="preview-card" Background="Black" CornerRadius="0,0,6,6" ClipToBounds="True"
	        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
	<Panel Background="Black">

		<!-- La surface native passe au-dessus de tout ce que peint la page : elle s'efface
		     tant que l'écran vide a quelque chose à dire à sa place. -->
		<controls:StudioPreview Scene="{Binding ActiveScene}"
                                IsVisible="{Binding !ShowEmptyPreview}"
                                PreviewRuntime="{Binding PreviewRuntime}"
                                BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                Message="{Binding PreviewPlaceholderText}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

		<Panel Background="{DynamicResource AppPreviewEmptyBg}" IsVisible="{Binding ShowNoScene}">
			<controls:EmptyState Title="Aucune scène pour l'instant"
                                 Description="Créez une scène pour afficher votre direct ici."
                                 MascotHeight="190">
				<controls:EmptyState.Action>
					<Button Classes="primary" Content="Créer une scène" Command="{Binding OpenScenesCommand}"/>
				</controls:EmptyState.Action>
			</controls:EmptyState>
		</Panel>

		<Panel Background="{DynamicResource AppPreviewEmptyBg}" IsVisible="{Binding ShowNoVideoSource}">
			<controls:EmptyState Title="Aucune source vidéo"
                                 Description="Ajoutez une caméra, une capture d'écran ou une fenêtre pour afficher votre scène."
                                 MascotHeight="190">
				<controls:EmptyState.Action>
					<Button Classes="primary" Content="Ajouter une source" Command="{Binding OpenScenesCommand}"/>
				</controls:EmptyState.Action>
			</controls:EmptyState>
		</Panel>
</Panel>
	</Border>

</UserControl>
