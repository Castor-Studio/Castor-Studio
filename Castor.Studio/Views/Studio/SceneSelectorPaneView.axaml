<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:scenes="using:CastorApplication.ViewModels.Scenes"
             xmlns:converters="using:CastorApplication.Converters"
             x:Class="CastorApplication.Views.Studio.SceneSelectorPaneView"
             x:DataType="vm:StudioViewModel">

	<UserControl.Resources>
		<!-- Une scène dans la liste : sa pastille de couleur, son nom, et un rappel quand elle
		     n'a pas d'image — l'envoyer à l'antenne enverrait du noir. -->
		<DataTemplate x:Key="SceneItemTemplate" x:DataType="scenes:SceneItemViewModel">
			<StackPanel Orientation="Horizontal" Spacing="7">
				<Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
				<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
				<TextBlock Text="sans vidéo" IsVisible="{Binding !HasVideoSource}"
                           Foreground="{DynamicResource AppFg5}" FontSize="11" VerticalAlignment="Center"/>
			</StackPanel>
		</DataTemplate>

		<!-- Une transition = une icône. Son nom est porté par la case entière (style plus bas). -->
		<DataTemplate x:Key="TransitionIconTemplate" x:DataType="vm:SceneTransitionOption">
			<Viewbox Width="16" Height="16">
				<Canvas Width="24" Height="24">
					<Path Classes="transition-icon" Data="{Binding IconPath}" StrokeThickness="2"
                          StrokeLineCap="Round" StrokeJoin="Round"/>
				</Canvas>
			</Viewbox>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Choix de la transition : une rangée d'icônes jointives, la choisie en accent. -->
		<Style Selector="ListBox.segmented">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
		</Style>
		<!-- Infobulle et nom accessible sur toute la case, pas seulement sur le trait de l'icône :
		     sinon le survol des marges n'affiche rien. -->
		<Style Selector="ListBox.segmented ListBoxItem" x:DataType="vm:SceneTransitionOption">
			<Setter Property="ToolTip.Tip" Value="{Binding Label}"/>
			<Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem">
			<Setter Property="Padding" Value="9,7"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:selected:focus /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="Path.transition-icon">
			<Setter Property="Stroke" Value="{DynamicResource AppFg3}"/>
		</Style>
		<Style Selector="ListBoxItem:selected Path.transition-icon">
			<Setter Property="Stroke" Value="{DynamicResource AppAccentFg}"/>
		</Style>

		<Style Selector="TextBlock.duration">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg4}"/>
			<Setter Property="MinWidth" Value="48"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<!-- Bottom half of the pane card: rounds/outlines the sides + bottom, the dock's title bar does the top (DockTheme.axaml). -->
	<Border x:Name="PaneRoot" Background="{DynamicResource AppSurface}" CornerRadius="0,0,8,8" Padding="12,6"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
		<Panel>

			<!-- Landscape: scene, transition and duration on the left, status on the right. The
			     free column between them is room for more information later. -->
			<Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto" ColumnSpacing="14"
                  IsVisible="{Binding #PaneRoot.Bounds, Converter={x:Static converters:IsLandscapeConverter.Instance}}">
				<ComboBox Grid.Column="0"
                          ItemsSource="{Binding Scenes}"
                          ItemTemplate="{StaticResource SceneItemTemplate}"
                          SelectedItem="{Binding ActiveScene}"
                          PlaceholderText="Aucune scène"
                          MinWidth="170" VerticalAlignment="Center"
                          ToolTip.Tip="Scène envoyée au live et à l'enregistrement"
                          Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}"/>
				<ListBox Grid.Column="1" Classes="segmented" VerticalAlignment="Center"
                         ItemsSource="{Binding TransitionOptions}"
                         SelectedItem="{Binding SelectedTransition}"
                         ItemTemplate="{StaticResource TransitionIconTemplate}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>
				<Grid Grid.Column="2" ColumnDefinitions="110, Auto" ColumnSpacing="8"
                      IsEnabled="{Binding IsTransitionAnimated}" VerticalAlignment="Center"
                      ToolTip.Tip="Durée de la transition">
					<Slider Minimum="0" Maximum="{Binding TransitionDurationLastStep}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TransitionDurationStep}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Classes="duration" Text="{Binding TransitionDurationText}"/>
				</Grid>
				<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<Ellipse Width="7" Height="7" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.ready="{Binding !IsOnAir}" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding SceneBarStatusText}" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.ready="{Binding !IsOnAir}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>

			<!-- Portrait: the same controls stacked, full width. -->
			<StackPanel Orientation="Vertical" Spacing="8"
                        IsVisible="{Binding #PaneRoot.Bounds, Converter={x:Static converters:IsPortraitConverter.Instance}}">
				<ComboBox ItemsSource="{Binding Scenes}"
                          ItemTemplate="{StaticResource SceneItemTemplate}"
                          SelectedItem="{Binding ActiveScene}"
                          PlaceholderText="Aucune scène"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Scène envoyée au live et à l'enregistrement"
                          Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}"/>
				<ListBox Classes="segmented" HorizontalAlignment="Center"
                         ItemsSource="{Binding TransitionOptions}"
                         SelectedItem="{Binding SelectedTransition}"
                         ItemTemplate="{StaticResource TransitionIconTemplate}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>
				<Grid ColumnDefinitions="*, Auto" ColumnSpacing="8"
                      IsEnabled="{Binding IsTransitionAnimated}" ToolTip.Tip="Durée de la transition">
					<Slider Minimum="0" Maximum="{Binding TransitionDurationLastStep}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TransitionDurationStep}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Classes="duration" Text="{Binding TransitionDurationText}"/>
				</Grid>
				<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
					<Ellipse Width="7" Height="7" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.ready="{Binding !IsOnAir}" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding SceneBarStatusText}" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.ready="{Binding !IsOnAir}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</StackPanel>

		</Panel>
	</Border>

</UserControl>
