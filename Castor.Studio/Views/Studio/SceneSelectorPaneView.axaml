<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:scenes="using:CastorApplication.ViewModels.Scenes"
             xmlns:converters="using:CastorApplication.Converters"
             x:Class="CastorApplication.Views.Studio.SceneSelectorPaneView"
             x:DataType="vm:StudioViewModel">

	<UserControl.Resources>
		<!-- The Fluent Slider reserves 15 px above and below its track (room for a header and
		     ticks not shown here): in a low bar, the track fell below the other controls' axis.
		     Without these margins, it centers. -->
		<GridLength x:Key="SliderPreContentMargin">0</GridLength>
		<GridLength x:Key="SliderPostContentMargin">0</GridLength>

		<!-- A scene in the list: its color dot, its name, and a reminder when it has no image, as
		     sending it on air would send black. -->
		<DataTemplate x:Key="SceneItemTemplate" x:DataType="scenes:SceneItemViewModel">
			<StackPanel Orientation="Horizontal" Spacing="7">
				<Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
				<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
				<TextBlock Text="sans vidéo" IsVisible="{Binding !HasVideoSource}"
                           Foreground="{DynamicResource AppFg5}" FontSize="11" VerticalAlignment="Center"/>
				<TextBlock Text="REC" IsVisible="{Binding IsBeingRecorded}"
                           Foreground="{DynamicResource StatusRecBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
			</StackPanel>
		</DataTemplate>

		<!-- One transition = one icon. Its name is carried by the whole cell (style below). -->
		<DataTemplate x:Key="TransitionIconTemplate" x:DataType="vm:SceneTransitionOption">
			<Viewbox Width="18" Height="18">
				<Canvas Width="24" Height="24">
					<Path Classes="transition-icon" Data="{Binding IconPath}" StrokeThickness="2"
                          StrokeLineCap="Round" StrokeJoin="Round"/>
				</Canvas>
			</Viewbox>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Transition choice: a row of adjoining icons, the chosen one in accent. -->
		<Style Selector="ListBox.segmented">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
		</Style>
		<!-- Tooltip and accessible name on the whole cell, not just the icon's stroke: otherwise
		     hovering the margins shows nothing. -->
		<Style Selector="ListBox.segmented ListBoxItem" x:DataType="vm:SceneTransitionOption">
			<Setter Property="ToolTip.Tip" Value="{Binding Label}"/>
			<Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="ListBox.segmented ListBoxItem:selected:focus /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="Path.transition-icon">
			<Setter Property="Stroke" Value="{DynamicResource AppFg3}"/>
		</Style>
		<Style Selector="ListBoxItem:selected Path.transition-icon">
			<Setter Property="Stroke" Value="{DynamicResource AppAccentFg}"/>
		</Style>

		<!-- The "Prêt" pill: solid in light, plain green text in dark. -->
		<Style Selector="Border.ready-pill">
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="12,4"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style Selector="Border.ready-pill.ready">
			<Setter Property="Background" Value="{DynamicResource AppReadyPillBg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppReadyPillBorder}"/>
		</Style>
		<Style Selector="Border.ready-pill.ready TextBlock.session-state.ready">
			<Setter Property="Foreground" Value="{DynamicResource AppReadyFg}"/>
		</Style>
		<Style Selector="Border.ready-pill.ready Ellipse.session-state.ready">
			<Setter Property="Fill" Value="{DynamicResource AppReadyFg}"/>
		</Style>

		<Style Selector="TextBlock.duration">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg4}"/>
			<Setter Property="MinWidth" Value="48"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<!-- Bottom half of the pane card: rounds/outlines the sides + bottom, the dock's title bar does the top (DockTheme.axaml). -->
	<Border x:Name="PaneRoot" Background="{DynamicResource AppSurface}" CornerRadius="0,0,6,6" Padding="14,4,14,12"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
		<Panel>

			<!-- Landscape: scene, transition and duration on the left, status on the right. The
			     free column between them is room for more information later. -->
			<Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto" ColumnSpacing="14"
                  IsVisible="{Binding #PaneRoot.Bounds, Converter={x:Static converters:IsLandscapeConverter.Instance}}">
				<ComboBox Grid.Column="0"
                          ItemsSource="{Binding Scenes}"
                          ItemTemplate="{StaticResource SceneItemTemplate}"
                          SelectedItem="{Binding ActiveScene}"
                          PlaceholderText="Aucune scène"
                          MinWidth="200" VerticalAlignment="Center"
                          ToolTip.Tip="Scène envoyée au live et à l'enregistrement"/>
				<ListBox Grid.Column="1" Classes="segmented" VerticalAlignment="Center"
                         ItemsSource="{Binding TransitionOptions}"
                         SelectedItem="{Binding SelectedTransition}"
                         ItemTemplate="{StaticResource TransitionIconTemplate}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>
				<Grid Grid.Column="2" ColumnDefinitions="130, Auto" ColumnSpacing="10"
                      IsEnabled="{Binding IsTransitionAnimated}" VerticalAlignment="Center"
                      ToolTip.Tip="Durée de la transition">
					<Slider Minimum="0" Maximum="{Binding TransitionDurationLastStep}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TransitionDurationStep}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Classes="duration" Text="{Binding TransitionDurationText}"/>
				</Grid>
				<Border Grid.Column="4" Classes="ready-pill" Classes.ready="{Binding !IsOnAir}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6">
					<Ellipse Width="8" Height="8" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.paused="{Binding IsRecordingPaused}" Classes.ready="{Binding !IsOnAir}" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding SceneBarStatusText}" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.paused="{Binding IsRecordingPaused}" Classes.ready="{Binding !IsOnAir}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel></Border>
			</Grid>

			<!-- Portrait: the same controls stacked, full width. -->
			<StackPanel Orientation="Vertical" Spacing="8"
                        IsVisible="{Binding #PaneRoot.Bounds, Converter={x:Static converters:IsPortraitConverter.Instance}}">
				<ComboBox ItemsSource="{Binding Scenes}"
                          ItemTemplate="{StaticResource SceneItemTemplate}"
                          SelectedItem="{Binding ActiveScene}"
                          PlaceholderText="Aucune scène"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Scène envoyée au live et à l'enregistrement"/>
				<ListBox Classes="segmented" HorizontalAlignment="Center"
                         ItemsSource="{Binding TransitionOptions}"
                         SelectedItem="{Binding SelectedTransition}"
                         ItemTemplate="{StaticResource TransitionIconTemplate}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>
				<Grid ColumnDefinitions="*, Auto" ColumnSpacing="8"
                      IsEnabled="{Binding IsTransitionAnimated}" ToolTip.Tip="Durée de la transition">
					<Slider Minimum="0" Maximum="{Binding TransitionDurationLastStep}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TransitionDurationStep}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Classes="duration" Text="{Binding TransitionDurationText}"/>
				</Grid>
				<Border Classes="ready-pill" Classes.ready="{Binding !IsOnAir}" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6">
					<Ellipse Width="8" Height="8" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.paused="{Binding IsRecordingPaused}" Classes.ready="{Binding !IsOnAir}" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding SceneBarStatusText}" Classes="session-state" Classes.live="{Binding IsOnAir}" Classes.paused="{Binding IsRecordingPaused}" Classes.ready="{Binding !IsOnAir}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel></Border>
			</StackPanel>

		</Panel>
	</Border>

</UserControl>
