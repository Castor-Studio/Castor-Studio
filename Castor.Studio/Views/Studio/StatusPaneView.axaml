<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:converters="using:CastorApplication.Converters"
             x:Class="CastorApplication.Views.Studio.StatusPaneView"
             x:DataType="vm:StudioViewModel">

	<!-- Bottom half of the pane's rounded card: the dock's title bar above rounds the top
         corners and draws the top/side border (DockTheme.axaml); this completes the same
         1px outline on the sides/bottom and rounds the bottom corners, flat at the seam. -->
	<Border x:Name="PaneRoot" Background="{DynamicResource AppSurface}" CornerRadius="0,0,8,8" Padding="12,8"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
		<Panel>

			<!-- Landscape: badge, timer and output info in a row. -->
			<!-- Items spread across the full width: the two star columns are flexible gaps
                 that grow with the pane and shrink first when it narrows. A fixed 12px
                 margin on each side keeps the items apart even when the gaps hit zero;
                 the screen-relative pane minimum (StudioDockSizing) stops them overflowing. -->
			<Grid ColumnDefinitions="Auto, *, Auto, *, Auto"
                  IsVisible="{Binding #PaneRoot.Bounds, Converter={x:Static converters:IsLandscapeConverter.Instance}}">

				<Border Grid.Column="0" Padding="8,4" CornerRadius="5" Margin="0,0,12,0"
                        Background="{DynamicResource AppSurface3}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
					<StackPanel Orientation="Horizontal" Spacing="5">
						<Ellipse Width="7" Height="7" Fill="{Binding StreamStatusBrush}" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding StreamStatusText}"
                                   Foreground="{Binding StreamStatusBrush}"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<TextBlock Grid.Column="2" Text="{Binding StreamTimerText}"
                           Foreground="{Binding StreamTimerBrush}"
                           FontSize="14" FontFamily="Consolas"
                           Margin="12,0" VerticalAlignment="Center"/>

				<TextBlock Grid.Column="4" Text="{Binding OutputInfoText}"
                           Foreground="{DynamicResource AppFg6}" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
			</Grid>

			<!-- Portrait: same information stacked top to bottom instead of side by side. -->
			<StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center"
                        IsVisible="{Binding #PaneRoot.Bounds, Converter={x:Static converters:IsPortraitConverter.Instance}}">

				<Border Padding="8,4" CornerRadius="5" HorizontalAlignment="Center"
                        Background="{DynamicResource AppSurface3}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
					<StackPanel Orientation="Horizontal" Spacing="5">
						<Ellipse Width="7" Height="7" Fill="{Binding StreamStatusBrush}" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding StreamStatusText}"
                                   Foreground="{Binding StreamStatusBrush}"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<TextBlock Text="{Binding StreamTimerText}"
                           Foreground="{Binding StreamTimerBrush}"
                           FontSize="14" FontFamily="Consolas"
                           HorizontalAlignment="Center"/>

				<TextBlock Text="{Binding OutputInfoText}"
                           Foreground="{DynamicResource AppFg6}" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           HorizontalAlignment="Center"/>
			</StackPanel>

		</Panel>
	</Border>

</UserControl>
