<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             x:Class="CastorApplication.Views.Studio.StatusPaneView"
             x:DataType="vm:StudioViewModel">

	<Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="12,0"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Margin="8,4,8,4">
		<Grid ColumnDefinitions="Auto, Auto, *">

			<Border Grid.Column="0" Padding="8,4" CornerRadius="5"
                    Background="{DynamicResource AppSurface3}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
				<StackPanel Orientation="Horizontal" Spacing="5">
					<Ellipse Width="7" Height="7" Fill="{Binding StreamStatusBrush}" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding StreamStatusText}"
                               Foreground="{Binding StreamStatusBrush}"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<TextBlock Grid.Column="1" Text="{Binding StreamTimerText}"
                       Foreground="{Binding StreamTimerBrush}"
                       FontSize="14" FontFamily="Consolas"
                       Margin="12,0" VerticalAlignment="Center"/>

			<!-- Least essential info: shrinks and ellipsizes first when the pane narrows. -->
			<TextBlock Grid.Column="2" Text="{Binding OutputInfoText}"
                       Foreground="{DynamicResource AppFg6}" FontSize="11"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       VerticalAlignment="Center"/>
		</Grid>
	</Border>

</UserControl>
