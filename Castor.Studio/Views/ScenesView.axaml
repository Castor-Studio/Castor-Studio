<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Scenes"
             xmlns:m="using:CastorApplication.ViewModels.Scenes"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.ScenesView"
             x:Name="ScenesRoot"
             x:DataType="vm:ScenesViewModel">

	<UserControl.Styles>

		<Style Selector="Button.source-type-btn">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.source-type-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavBadgeBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
		</Style>

		<Style Selector="Button.scene-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.scene-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
		</Style>

		<Style Selector="Button.scene-btn.selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg2}"/>
		</Style>
		<Style Selector="Button.scene-btn.selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg2}"/>
		</Style>

	</UserControl.Styles>

	<Grid ColumnDefinitions="240, 1, *" Background="{DynamicResource AppBg}">

		<!-- ═══ SCENES LIST ═══ -->
		<Border Grid.Column="0" Background="{DynamicResource AppSurface}">
			<Grid RowDefinitions="56, Auto, Auto, Auto, 1, *">

				<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="14,0">
					<TextBlock Grid.Column="0" Text="SCÈNES"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppFg4}"
                               VerticalAlignment="Center"/>

					<!-- Create Scene Flyout -->
					<Button Grid.Column="1"
                            Content="+"
                            Background="{DynamicResource AppAccentBg}" Foreground="#5b8def"
                            BorderThickness="0" Padding="10,4" CornerRadius="5"
                            FontSize="16" FontWeight="Bold"
                            VerticalAlignment="Center" Cursor="Hand">
						<Button.Flyout>
							<Flyout Placement="Right">
								<StackPanel Width="260" Spacing="12" Margin="4"
                                            controls:FlyoutActions.Error="{Binding CreateSceneError}">
									<TextBlock Text="NOUVELLE SCÈNE"
                                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
									<Rectangle Height="1" Fill="{DynamicResource AppBorder2}"/>
									<StackPanel Spacing="4">
										<TextBlock Text="Nom de la scène" Foreground="{DynamicResource AppFg3}" FontSize="11"/>
										<TextBox Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"
											PlaceholderText="Ex: Match Live"
											Background="{DynamicResource AppSurface2}"
											BorderBrush="{DynamicResource AppBorder2}"
											Foreground="{DynamicResource AppFg2}"
											controls:FlyoutActions.EnterCommand="{Binding CreateSceneCommand}"/>
									</StackPanel>
									<TextBlock Text="{Binding CreateSceneError}"
                                               IsVisible="{Binding CreateSceneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{StaticResource StatusErrorBrush}" FontSize="11" TextWrapping="Wrap"/>
									<Button Content="CRÉER LA SCÈNE"
                                            Command="{Binding CreateSceneCommand}"
                                            controls:FlyoutActions.CloseOnSuccess="True"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Height="36" Background="#5b8def" Foreground="#eaeaf0"
                                            BorderThickness="0" CornerRadius="6"
                                            FontSize="12" FontWeight="Bold" Cursor="Hand"/>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>
				</Grid>

				<!-- Toolbar: sort + fichier + selection mode -->
				<StackPanel Grid.Row="1" Margin="8,0,8,8" Spacing="1">

					<Button Classes="scene-toolbar-item">
						<Grid ColumnDefinitions="20, *, Auto">
							<Viewbox Grid.Column="0" Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
								<Canvas Width="24" Height="24">
									<Path Data="M3 9l4 -4l4 4m-4 -4v14"
                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
									<Path Data="M21 15l-4 4l-4 -4m4 4v-14"
                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
								</Canvas>
							</Viewbox>
							<TextBlock Grid.Column="1" Text="Trier" Margin="6,0,0,0" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource AppFg5}"/>
						</Grid>
						<Button.Flyout>
							<Flyout Placement="RightEdgeAlignedTop">
								<StackPanel Width="180" Spacing="2" Margin="4">
									<TextBlock Text="TRIER PAR"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AppFg4}" Margin="10,2,0,4"/>
									<Button Classes="scene-menu-item" Content="Nom (A → Z)"
                                            Command="{Binding SortScenesCommand}" CommandParameter="name_asc"/>
									<Button Classes="scene-menu-item" Content="Nom (Z → A)"
                                            Command="{Binding SortScenesCommand}" CommandParameter="name_desc"/>
									<Button Classes="scene-menu-item" Content="Plus récentes d'abord"
                                            Command="{Binding SortScenesCommand}" CommandParameter="date_desc"/>
									<Button Classes="scene-menu-item" Content="Plus anciennes d'abord"
                                            Command="{Binding SortScenesCommand}" CommandParameter="date_asc"/>
									<Button Classes="scene-menu-item" Content="Couleur"
                                            Command="{Binding SortScenesCommand}" CommandParameter="color"/>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<!-- Direct actions, not a "Fichier" submenu: the menu bar owns the only "Fichier". -->
					<Button Classes="scene-toolbar-item"
                            Command="{Binding ImportScenesCommand}"
                            ToolTip.Tip="Importer des scènes depuis un fichier">
						<Grid ColumnDefinitions="20, *, Auto">
							<Viewbox Grid.Column="0" Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
								<Canvas Width="24" Height="24">
									<Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2M7 11l5 5l5 -5M12 4v12"
                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
								</Canvas>
							</Viewbox>
							<TextBlock Grid.Column="1" Text="Importer…" Margin="6,0,0,0" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<Button Classes="scene-toolbar-item"
                            Command="{Binding ExportScenesCommand}"
                            ToolTip.Tip="Exporter les scènes sélectionnées, ou toutes si aucune ne l'est">
						<Grid ColumnDefinitions="20, *, Auto">
							<Viewbox Grid.Column="0" Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
								<Canvas Width="24" Height="24">
									<Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2M7 9l5 -5l5 5M12 4v12"
                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
								</Canvas>
							</Viewbox>
							<TextBlock Grid.Column="1" Text="Exporter…" Margin="6,0,0,0" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<ToggleButton Classes="scene-toolbar-item"
                                  IsChecked="{Binding IsSelectionModeActive}">
						<Grid ColumnDefinitions="20, *, Auto">
							<Viewbox Grid.Column="0" Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
								<Canvas Width="24" Height="24">
									<Path Data="M9 11l3 3l8 -8"
                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
									<Path Data="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9"
                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
								</Canvas>
							</Viewbox>
							<TextBlock Grid.Column="1" Text="Sélectionner" Margin="6,0,0,0" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2" Text="✓" Foreground="#5b8def"
                                       IsVisible="{Binding IsSelectionModeActive}"/>
						</Grid>
					</ToggleButton>

				</StackPanel>

				<TextBlock Grid.Row="2" Text="{Binding SceneIoStatus}"
                           IsVisible="{Binding SceneIoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource AppFg3}" FontSize="10" TextWrapping="Wrap"
                           Margin="14,0,14,8"/>

				<!-- Bulk actions bar -->
				<StackPanel Grid.Row="3" Margin="8,6" Spacing="1"
                            IsVisible="{Binding IsSelectionModeActive}">

					<TextBlock Text="{Binding DeleteSceneError}"
                               IsVisible="{Binding DeleteSceneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource StatusErrorBrush}" FontSize="10" TextWrapping="Wrap"
                               Margin="10,0,10,6"/>

					<Button Classes="scene-toolbar-item">
						<Grid ColumnDefinitions="20, *, Auto">
							<Ellipse Grid.Column="0" Width="12" Height="12" Fill="#5b8def"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Text="Couleur de la sélection" Margin="6,0,0,0" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource AppFg5}"/>
						</Grid>
						<Button.Flyout>
							<Flyout Placement="RightEdgeAlignedTop">
								<StackPanel Width="200" Spacing="8" Margin="4">
									<TextBlock Text="COULEUR DE LA SÉLECTION"
                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
									<Rectangle Height="1" Fill="{DynamicResource AppBorder2}"/>
									<ItemsControl ItemsSource="{x:Static vm:ScenesViewModel.SceneColorPalette}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="x:String">
												<Button Width="24" Height="24" CornerRadius="12" Margin="3"
                                                        Background="{Binding}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource AppBorder2}"
                                                        Padding="0" Cursor="Hand"
                                                        Command="{Binding #ScenesRoot.DataContext.AssignColorToSelectionCommand}"
                                                        CommandParameter="{Binding}"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<Button Classes="scene-toolbar-item"
                            Command="{Binding StartSelectedFileScenesTogetherCommand}"
                            ToolTip.Tip="Démarre en même temps les scènes sélectionnées qui contiennent une source fichier">
						<Grid ColumnDefinitions="20, *">
							<TextBlock Grid.Column="0" Text="▶" FontSize="10" Foreground="{DynamicResource AppFg4}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Text="Démarrer ensemble" Margin="6,0,0,0" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<Button Classes="scene-toolbar-item danger"
                            Command="{Binding DeleteSelectedScenesCommand}">
						<Grid ColumnDefinitions="20, *">
							<TextBlock Grid.Column="0" Text="✕" FontSize="11" Foreground="{StaticResource StatusErrorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Text="Supprimer la sélection" Margin="6,0,0,0" VerticalAlignment="Center"/>
						</Grid>
					</Button>

				</StackPanel>

				<Rectangle Grid.Row="4" Fill="{DynamicResource AppBorder}"/>

				<!-- Dynamic scene list -->
				<ScrollViewer Grid.Row="5">
					<ItemsControl ItemsSource="{Binding Scenes}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="m:SceneItemViewModel">
								<Grid ColumnDefinitions="Auto, Auto, *, Auto"
                                      DragDrop.AllowDrop="True">

									<CheckBox Grid.Column="0"
                                              IsVisible="{Binding #ScenesRoot.DataContext.IsSelectionModeActive}"
                                              IsChecked="{Binding IsMultiSelected}"
                                              VerticalAlignment="Center" Margin="10,0,0,0"/>

									<Border Grid.Column="1" Width="22"
                                            Background="Transparent" Cursor="SizeAll"
                                            ToolTip.Tip="Glisser pour réordonner">
										<TextBlock Text="⠿" FontSize="14"
                                                   Foreground="{DynamicResource AppFg5}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>

									<Button Grid.Column="2" Classes="scene-btn" Classes.selected="{Binding IsSelected}"
                                            Command="{Binding #ScenesRoot.DataContext.SelectSceneCommand}"
                                            CommandParameter="{Binding}">
										<Grid ColumnDefinitions="*, Auto" Margin="14,10,10,10">
											<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
												<Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
												<TextBlock Text="▶" IsVisible="{Binding IsSelected}"
                                                               Foreground="{DynamicResource AppAccentFg}" FontSize="10"
                                                               VerticalAlignment="Center"/>
												<TextBlock Text="{Binding Name}" IsVisible="{Binding IsSelected}"
                                                               Foreground="{DynamicResource AppFg1}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
												<TextBlock Text="{Binding Name}" IsVisible="{Binding !IsSelected}"
                                                               Foreground="{DynamicResource AppFg3}" FontSize="13"
                                                               VerticalAlignment="Center"/>
											</StackPanel>
											<Border Grid.Column="1"
                                                            IsVisible="{Binding IsLive}"
                                                            Background="#5b8def" CornerRadius="3" Padding="6,2">
												<TextBlock Text="EN DIRECT" Foreground="#eaeaf0"
                                                               FontSize="9" FontWeight="Bold"/>
											</Border>
										</Grid>
									</Button>

									<!-- Actions -->
									<Button Grid.Column="3"
                                            Content="⋮"
                                            Background="Transparent" Foreground="{DynamicResource AppFg5}"
                                            BorderThickness="0" FontSize="16" FontWeight="Bold" Padding="8,4"
                                            Cursor="Hand"
                                            ToolTip.Tip="Actions">
										<Button.Flyout>
											<Flyout Placement="BottomEdgeAlignedRight">
												<StackPanel Width="150" Spacing="2" Margin="4">

													<Button Classes="scene-menu-item" Content="Renommer"
                                                            Command="{Binding #ScenesRoot.DataContext.BeginRenameSceneCommand}"
                                                            CommandParameter="{Binding}">
														<Button.Flyout>
															<Flyout Placement="Right">
																<StackPanel Width="220" Spacing="10" Margin="4"
                                                                                controls:FlyoutActions.Error="{Binding #ScenesRoot.DataContext.RenameSceneError}">
																	<TextBlock Text="RENOMMER LA SCÈNE"
                                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
																	<Rectangle Height="1" Fill="{DynamicResource AppBorder2}"/>
																	<TextBox Text="{Binding #ScenesRoot.DataContext.RenameSceneName, UpdateSourceTrigger=PropertyChanged}"
																		Background="{DynamicResource AppSurface2}"
																		BorderBrush="{DynamicResource AppBorder2}"
																		Foreground="{DynamicResource AppFg2}"
																		controls:FlyoutActions.EnterCommand="{Binding #ScenesRoot.DataContext.ConfirmRenameSceneCommand}"/>
																	<TextBlock Text="{Binding #ScenesRoot.DataContext.RenameSceneError}"
                                                                               IsVisible="{Binding #ScenesRoot.DataContext.RenameSceneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                               Foreground="{StaticResource StatusErrorBrush}" FontSize="10" TextWrapping="Wrap"/>
																	<Button Content="RENOMMER"
                                                                            Command="{Binding #ScenesRoot.DataContext.ConfirmRenameSceneCommand}"
                                                                            controls:FlyoutActions.CloseOnSuccess="True"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                            Height="32" Background="#5b8def" Foreground="#eaeaf0"
                                                                            BorderThickness="0" CornerRadius="6"
                                                                            FontSize="12" FontWeight="Bold" Cursor="Hand"/>
																</StackPanel>
															</Flyout>
														</Button.Flyout>
													</Button>

													<Button Classes="scene-menu-item" Content="Couleur"
                                                            Command="{Binding #ScenesRoot.DataContext.BeginAssignColorCommand}"
                                                            CommandParameter="{Binding}">
														<Button.Flyout>
															<Flyout Placement="Right">
																<StackPanel Width="200" Spacing="8" Margin="4">
																	<TextBlock Text="COULEUR DE LA SCÈNE"
                                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
																	<Rectangle Height="1" Fill="{DynamicResource AppBorder2}"/>
																	<ItemsControl ItemsSource="{x:Static vm:ScenesViewModel.SceneColorPalette}">
																		<ItemsControl.ItemsPanel>
																			<ItemsPanelTemplate>
																				<WrapPanel/>
																			</ItemsPanelTemplate>
																		</ItemsControl.ItemsPanel>
																		<ItemsControl.ItemTemplate>
																			<DataTemplate x:DataType="x:String">
																				<Button Width="24" Height="24" CornerRadius="12" Margin="3"
                                                                                        Background="{Binding}"
                                                                                        BorderThickness="1" BorderBrush="{DynamicResource AppBorder2}"
                                                                                        Padding="0" Cursor="Hand"
                                                                                        controls:FlyoutActions.CloseOnSuccess="True"
                                                                                        Command="{Binding #ScenesRoot.DataContext.AssignSceneColorCommand}"
                                                                                        CommandParameter="{Binding}"/>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																</StackPanel>
															</Flyout>
														</Button.Flyout>
													</Button>

													<Rectangle Height="1" Fill="{DynamicResource AppBorder2}" Margin="4,2"/>

													<Button Classes="scene-menu-item danger" Content="Supprimer">
														<Button.Flyout>
															<Flyout Placement="Right">
																<StackPanel Width="200" Spacing="10" Margin="4"
                                                                                controls:FlyoutActions.Error="{Binding #ScenesRoot.DataContext.DeleteSceneError}">
																	<TextBlock Text="SUPPRIMER LA SCÈNE"
                                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"/>
																	<Rectangle Height="1" Fill="{DynamicResource AppBorder2}"/>
																	<TextBlock Text="Cette action est définitive. Supprimer cette scène ?"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="11" Foreground="{DynamicResource AppFg3}"/>
																	<TextBlock Text="{Binding #ScenesRoot.DataContext.DeleteSceneError}"
                                                                               IsVisible="{Binding #ScenesRoot.DataContext.DeleteSceneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                               Foreground="{StaticResource StatusErrorBrush}" FontSize="10" TextWrapping="Wrap"/>
																	<Button Content="SUPPRIMER"
                                                                            Command="{Binding #ScenesRoot.DataContext.DeleteSceneCommand}"
                                                                            controls:FlyoutActions.CloseOnSuccess="True"
                                                                            CommandParameter="{Binding}"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                            Height="32" Background="{StaticResource StatusErrorBrush}" Foreground="#eaeaf0"
                                                                            BorderThickness="0" CornerRadius="6"
                                                                            FontSize="12" FontWeight="Bold" Cursor="Hand"/>
																</StackPanel>
															</Flyout>
														</Button.Flyout>
													</Button>

												</StackPanel>
											</Flyout>
										</Button.Flyout>
									</Button>

								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

			</Grid>
		</Border>

		<Rectangle Grid.Column="1" Fill="{DynamicResource AppBorder}"/>

		<!-- ═══ RIGHT PANEL ═══ -->
		<Grid Grid.Column="2" RowDefinitions="*, 8, 200" Margin="8">

			<!-- Scene preview -->
			<Border Grid.Row="0"
                    Background="Black" CornerRadius="8"
                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                    ClipToBounds="True">
				<Panel>
				<controls:StudioPreview Scene="{Binding SelectedScene}"
                                            PreviewRuntime="{Binding PreviewRuntime}"
                                            BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                            BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                            Message="{Binding PreviewPlaceholderText}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
				</Panel>
			</Border>

			<Rectangle Grid.Row="1" Fill="Transparent"/>

			<!-- Sources of selected scene -->
			<Border Grid.Row="2" Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="14">
				<Grid RowDefinitions="Auto, 10, *, Auto">

					<Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">
						<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<TextBlock Text="SOURCES"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppFg4}"
                                       VerticalAlignment="Center"/>
							<Border Background="{DynamicResource AppSurface2}" CornerRadius="8" Padding="6,1"
                                    IsVisible="{Binding SourceListSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    VerticalAlignment="Center">
								<TextBlock Text="{Binding SourceListSummary}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppFg4}"/>
							</Border>
						</StackPanel>

						<!-- Trier / filtrer : ne change que l'affichage, jamais l'ordre de composition.
						     Même flyout que « Trier » sur les scènes ; teinté quand un tri ou un filtre
						     est actif, pour qu'une liste incomplète ne passe pas inaperçue. -->
						<Button Grid.Column="1" Margin="0,0,6,0"
                                BorderThickness="0" Padding="8,5" CornerRadius="5" Cursor="Hand"
                                Background="Transparent"
                                Classes.customized="{Binding IsSourceListCustomized}"
                                ToolTip.Tip="Trier et filtrer les sources">
							<Button.Styles>
								<Style Selector="Button.customized">
									<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<Viewbox Width="14" Height="14" VerticalAlignment="Center">
									<Canvas Width="24" Height="24">
										<Path Data="M3 9l4 -4l4 4m-4 -4v14"
                                              Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round"/>
										<Path Data="M21 15l-4 4l-4 -4m4 4v-14"
                                              Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round"/>
									</Canvas>
								</Viewbox>
								<TextBlock Text="Trier" FontSize="11" Foreground="{DynamicResource AppFg3}" VerticalAlignment="Center"/>
							</StackPanel>
							<Button.Flyout>
								<Flyout Placement="TopEdgeAlignedRight">
									<StackPanel Width="200" Spacing="2" Margin="4">
										<TextBlock Text="TRIER PAR"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppFg4}" Margin="10,2,0,4"/>
										<ItemsControl ItemsSource="{Binding SourceSortOptions}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="m:SourceListOption">
													<Button Classes="scene-menu-item"
                                                            Command="{Binding #ScenesRoot.DataContext.ApplySourceListOptionCommand}"
                                                            CommandParameter="{Binding}">
														<Grid ColumnDefinitions="*, Auto">
															<TextBlock Text="{Binding Label}"/>
															<TextBlock Grid.Column="1" Text="✓" Foreground="#5b8def"
                                                                       IsVisible="{Binding IsSelected}"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<Rectangle Height="1" Fill="{DynamicResource AppBorder2}" Margin="4,4"/>

										<TextBlock Text="AFFICHER"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppFg4}" Margin="10,2,0,4"/>
										<ItemsControl ItemsSource="{Binding SourceFilterOptions}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="m:SourceListOption">
													<Button Classes="scene-menu-item"
                                                            Command="{Binding #ScenesRoot.DataContext.ApplySourceListOptionCommand}"
                                                            CommandParameter="{Binding}">
														<Grid ColumnDefinitions="*, Auto">
															<TextBlock Text="{Binding Label}"/>
															<TextBlock Grid.Column="1" Text="✓" Foreground="#5b8def"
                                                                       IsVisible="{Binding IsSelected}"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<TextBlock Text="N'affecte que la liste : l'ordre des calques de la scène ne change pas."
                                                   TextWrapping="Wrap" FontSize="10"
                                                   Foreground="{DynamicResource AppFg5}" Margin="10,6,6,2"/>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
						</Button>

						<!-- Ouvre le dialogue « Ajouter une source » -->
						<Button Grid.Column="2"
                                Content="+"
                                Command="{Binding OpenAddSourceCommand}"
                                Background="{DynamicResource AppAccentBg}" Foreground="#5b8def"
                                BorderThickness="0" Padding="10,4" CornerRadius="5"
                                FontSize="16" FontWeight="Bold" Cursor="Hand"
                                ToolTip.Tip="Ajouter une source"/>
					</Grid>

					<Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppBorder}"/>

					<!-- Dynamic source list -->
					<TextBlock Grid.Row="2" Text="{Binding SourceListPlaceholder}"
                               IsVisible="{Binding SourceListPlaceholder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource AppFg5}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

					<ScrollViewer Grid.Row="2">
						<ItemsControl ItemsSource="{Binding DisplayedSources}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="m:SourceItemViewModel">
									<Border Background="{DynamicResource AppSurface2}" CornerRadius="5" Padding="10,7" Margin="0,2">
										<Grid ColumnDefinitions="16, *, Auto, Auto, Auto">
											<!-- Icône du type de source, dans la couleur de la source -->
											<Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
												<Canvas Width="24" Height="24">
													<Path Data="{Binding IconPath}"
                                                          Stroke="{Binding Color}" StrokeThickness="2"
                                                          StrokeLineCap="Round" StrokeJoin="Round"/>
												</Canvas>
											</Viewbox>
											<!-- Double-clic sur le nom : renommage en place. Entrée ou sortie du champ
											     valide, Échap annule. -->
											<TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       IsVisible="{Binding !IsRenaming}"
                                                       Background="Transparent"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="Double-cliquez pour renommer"
                                                       DoubleTapped="OnSourceNameDoubleTapped"
                                                       Foreground="{DynamicResource AppFg2}" FontSize="12"
                                                       Margin="8,0" VerticalAlignment="Center"/>
											<TextBox Grid.Column="1"
                                                     IsVisible="{Binding IsRenaming}"
                                                     Text="{Binding #ScenesRoot.DataContext.RenameSourceName, UpdateSourceTrigger=PropertyChanged}"
                                                     PropertyChanged="OnSourceRenameBoxPropertyChanged"
                                                     LostFocus="OnSourceRenameBoxLostFocus"
                                                     FontSize="12" Padding="6,2" MinHeight="0"
                                                     Margin="4,0" VerticalAlignment="Center"
                                                     Background="{DynamicResource AppSurface}"
                                                     BorderBrush="{DynamicResource AppAccentFg}"
                                                     Foreground="{DynamicResource AppFg1}">
												<TextBox.KeyBindings>
													<KeyBinding Gesture="Enter" Command="{Binding #ScenesRoot.DataContext.ConfirmRenameSourceCommand}"/>
													<KeyBinding Gesture="Escape" Command="{Binding #ScenesRoot.DataContext.CancelRenameSourceCommand}"/>
												</TextBox.KeyBindings>
											</TextBox>
											<TextBlock Grid.Column="2" Text="{Binding Type}"
                                                       Foreground="{DynamicResource AppFg4}" FontSize="10"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
											<!-- Bouton boucle — visible uniquement pour les sources fichier -->
							<ToggleButton Grid.Column="3"
                                                          IsVisible="{Binding IsFileSource}"
                                                          IsChecked="{Binding Loop, Mode=OneWay}"
                                                          Command="{Binding #ScenesRoot.DataContext.ToggleMediaLoopCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="Boucle automatique"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="4,2" Cursor="Hand"
                                                          FontSize="12">
												<ToggleButton.Styles>
													<Style Selector="ToggleButton:checked /template/ ContentPresenter">
														<Setter Property="Foreground" Value="#a78bfa"/>
													</Style>
													<Style Selector="ToggleButton:unchecked /template/ ContentPresenter">
														<Setter Property="Foreground" Value="{DynamicResource AppFg5}"/>
													</Style>
												</ToggleButton.Styles>
												<TextBlock Text="⟳" FontSize="14"/>
											</ToggleButton>
											<Button Grid.Column="4"
                                                    Content="✕"
                                                    Background="Transparent" Foreground="{DynamicResource AppFg5}"
                                                    BorderThickness="0" FontSize="11" Padding="4,2"
                                                    Cursor="Hand"
                                                    Command="{Binding #ScenesRoot.DataContext.RemoveSourceCommand}"
                                                    CommandParameter="{Binding}"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<TextBlock Grid.Row="3" Text="{Binding SourceOperationStatus}"
                               IsVisible="{Binding SourceOperationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource StatusErrorBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="2,6,2,0"/>
				</Grid>
			</Border>

		</Grid>

	</Grid>

</UserControl>
