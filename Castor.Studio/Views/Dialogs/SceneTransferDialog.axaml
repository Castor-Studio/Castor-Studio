<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CastorApplication.ViewModels.Scenes"
        x:Class="CastorApplication.Views.Dialogs.SceneTransferDialog"
        x:Name="DialogRoot"
        x:DataType="vm:SceneTransferDialogViewModel"
        Title="{Binding Title}"
        Width="520" Height="480"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

	<Window.Styles>
		<Style Selector="ListBox.scene-transfer-list">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ListBox.scene-transfer-list ListBoxItem">
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Margin" Value="0,1"/>
		</Style>
		<Style Selector="ListBox.scene-transfer-list ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
		</Style>
		<Style Selector="ListBox.scene-transfer-list ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</Window.Styles>

	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
		<KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}"/>
	</Window.KeyBindings>

	<Border Background="{DynamicResource AppSurface}" CornerRadius="10"
            BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
		<Grid RowDefinitions="46, 1, Auto, *, 1, 54">

			<!-- ── Header (déplaçable) ── -->
			<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,0,10,0"
                  Background="Transparent"
                  PointerPressed="OnHeaderPointerPressed">
				<TextBlock Grid.Column="0" Text="{Binding Title}"
                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                           VerticalAlignment="Center"/>
				<Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" CornerRadius="5" Cursor="Hand"
                        Foreground="{DynamicResource AppFg4}" FontSize="13"
                        Content="✕"/>
			</Grid>

			<Rectangle Grid.Row="1" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Tout cocher + fichiers illisibles ── -->
			<StackPanel Grid.Row="2" Margin="16,10,16,4" Spacing="8">
				<Border IsVisible="{Binding HasFileErrors}"
                        Background="#3b1219" CornerRadius="5" Padding="10,7"
                        BorderBrush="#7f1d1d" BorderThickness="1">
					<TextBlock Text="{Binding FileErrorsText}"
                               Foreground="{StaticResource StatusErrorBrush}" FontSize="11" TextWrapping="Wrap"/>
				</Border>
				<CheckBox IsChecked="{Binding AreAllChecked, Mode=OneWay}"
                          Command="{Binding ToggleAllCommand}"
                          Content="Tout cocher"
                          FontSize="12" Foreground="{DynamicResource AppFg3}"/>
			</StackPanel>

			<!-- ── Scènes ── -->
			<Panel Grid.Row="3" Margin="10,0,10,8">
				<ListBox Classes="scene-transfer-list"
                         ItemsSource="{Binding Items}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:SceneTransferItem">
							<CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch">
								<StackPanel Spacing="2" Margin="4,0,0,0">
									<TextBlock Text="{Binding Name}"
                                               FontSize="12" Foreground="{DynamicResource AppFg1}"
                                               TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding Detail}"
                                               FontSize="10" Foreground="{DynamicResource AppFg4}"
                                               TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding Collision}"
                                               IsVisible="{Binding HasCollision}"
                                               FontSize="10" Foreground="#fbbf24" TextWrapping="Wrap"/>
								</StackPanel>
							</CheckBox>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<TextBlock Text="Aucune scène trouvée."
                           IsVisible="{Binding !Items.Count}"
                           Foreground="{DynamicResource AppFg5}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Panel>

			<Rectangle Grid.Row="4" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Pied : combien seront écrites, puis annuler / confirmer ── -->
			<Grid Grid.Row="5" ColumnDefinitions="*, Auto, 8, Auto" Margin="16,0">
				<TextBlock Grid.Column="0" Text="{Binding Summary}"
                           Foreground="{DynamicResource AppFg3}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
				<Button Grid.Column="1" Classes="dlg-btn" Content="Annuler"
                        Command="{Binding CancelCommand}"
                        Background="{DynamicResource AppSurface2}"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                        Foreground="{DynamicResource AppFg3}"/>
				<Button Grid.Column="3" Classes="dlg-btn" Content="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding CanConfirm}"
                        Background="{DynamicResource AppAccentFg}" Foreground="#eaeaf0" BorderThickness="0"/>
			</Grid>

		</Grid>
	</Border>
</Window>
