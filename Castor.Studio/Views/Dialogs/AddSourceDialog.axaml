<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CastorApplication.Controls"
        xmlns:vm="using:CastorApplication.ViewModels.Scenes"
        xmlns:studioModels="using:CastorApplication.Models.Studio"
        x:Class="CastorApplication.Views.Dialogs.AddSourceDialog"
        x:Name="DialogRoot"
        x:DataType="vm:AddSourceDialogViewModel"
        Title="Ajouter une source"
        Width="640" Height="500"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

	<Window.Styles>

		<!-- Category (left column) -->
		<Style Selector="Button.cat-item">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="10,7"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.cat-item:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
		</Style>
		<Style Selector="Button.cat-item.selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>
		<Style Selector="Button.cat-item.selected">
			<Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
		</Style>

		<!-- Source list -->
		<Style Selector="ListBox.source-list">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ListBox.source-list ListBoxItem">
			<Setter Property="Padding" Value="10,7"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Margin" Value="0,1"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ListBox.source-list ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
		</Style>
		<Style Selector="ListBox.source-list ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>

	</Window.Styles>

	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
		<KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}"/>
	</Window.KeyBindings>

	<Border Background="{DynamicResource AppSurface}" CornerRadius="10"
            BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
		<Grid RowDefinitions="46, 1, *, 1, 54">

			<!-- ── Header (draggable) ── -->
			<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,0,10,0"
                  Background="Transparent"
				  PointerPressed="OnHeaderPointerPressed">
				<TextBlock Grid.Column="0" Text="AJOUTER UNE SOURCE"
                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                           VerticalAlignment="Center"/>
				<Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" CornerRadius="5" Cursor="Hand"
                        Foreground="{DynamicResource AppFg4}" FontSize="13"
                        Content="✕"/>
			</Grid>

			<Rectangle Grid.Row="1" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Content ── -->
			<Grid Grid.Row="2" ColumnDefinitions="176, 1, *">

				<!-- Categories -->
				<ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}" Margin="8">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:AddSourceCategoryItem">
							<Button Classes="cat-item" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #DialogRoot.DataContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding}">
								<Grid ColumnDefinitions="22, *, Auto">
									<Viewbox Grid.Column="0" Width="15" Height="15"
                                             HorizontalAlignment="Left" VerticalAlignment="Center">
										<Canvas Width="24" Height="24">
											<Path Data="{Binding IconPath}"
                                                  Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                                  StrokeLineCap="Round" StrokeJoin="Round"/>
										</Canvas>
									</Viewbox>
									<TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="2" Text="{Binding Count}"
                                               IsVisible="{Binding HasCount}"
                                               Foreground="{DynamicResource AppFg5}"
                                               FontSize="11" VerticalAlignment="Center"/>
								</Grid>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Rectangle Grid.Column="1" Fill="{DynamicResource AppBorder}"/>

				<!-- Right panel -->
				<Grid Grid.Column="2" Margin="10" RowDefinitions="Auto, *">

					<!-- Search + refresh (list categories only) -->
					<Grid Grid.Row="0" ColumnDefinitions="*, 6, Auto"
                          IsVisible="{Binding IsListCategory}" Margin="0,0,0,8">
						<TextBox Grid.Column="0" x:Name="SearchBox"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="Rechercher…"
                                 FontSize="12" Padding="8,5"
                                 Background="{DynamicResource AppSurface2}"
                                 Foreground="{DynamicResource AppFg1}"
                                 BorderBrush="{DynamicResource AppBorder2}"
                                 CornerRadius="5"/>
						<Button Grid.Column="2"
                                Command="{Binding RefreshCommand}"
                                Background="{DynamicResource AppSurface2}"
                                BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                                Padding="8,5" CornerRadius="5" Cursor="Hand"
                                ToolTip.Tip="Actualiser la liste">
							<Viewbox Width="14" Height="14">
								<Canvas Width="24" Height="24">
									<Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"
                                          Stroke="{DynamicResource AppFg3}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"/>
								</Canvas>
							</Viewbox>
						</Button>
					</Grid>

					<!-- Source list -->
					<Grid Grid.Row="1" RowDefinitions="*, Auto">
						<Panel Grid.Row="0" IsVisible="{Binding IsListCategory}">
							<ListBox Classes="source-list"
                                 ItemsSource="{Binding VisibleItems}"
                                 SelectedItem="{Binding SelectedItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:AddSourceItem">
									<Grid ColumnDefinitions="24, *, Auto" ToolTip.Tip="{Binding FullLabel}">
										<Viewbox Grid.Column="0" Width="16" Height="16"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center">
											<Canvas Width="24" Height="24">
												<Path Data="{Binding IconPath}"
                                                      Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                                      StrokeLineCap="Round" StrokeJoin="Round"/>
											</Canvas>
										</Viewbox>
										<StackPanel Grid.Column="1" Margin="8,0,8,0" Spacing="1"
                                                    VerticalAlignment="Center">
											<TextBlock Text="{Binding Title}"
                                                       FontSize="12" Foreground="{DynamicResource AppFg1}"
                                                       TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Detail}"
                                                       IsVisible="{Binding HasDetail}"
                                                       FontSize="10" Foreground="{DynamicResource AppFg4}"
                                                       TextTrimming="CharacterEllipsis"/>
										</StackPanel>
										<Border Grid.Column="2" IsVisible="{Binding AlreadyInScene}"
                                                Background="{DynamicResource AppSurface3}"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
											<TextBlock Text="déjà dans la scène"
                                                       FontSize="9" Foreground="{DynamicResource AppFg4}"/>
										</Border>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
							</ListBox>

							<TextBlock Text="Aucune source dans cette catégorie."
                                   IsVisible="{Binding !VisibleItems.Count}"
                                   Foreground="{DynamicResource AppFg5}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Panel>

						<!-- RTMP camera -->
						<Grid Grid.Row="0" IsVisible="{Binding IsNetworkCategory}" RowDefinitions="Auto, Auto, *">
						<StackPanel Grid.Row="0" Spacing="6">
							<TextBlock Text="Adresse du flux"
                                       Foreground="{DynamicResource AppFg3}" FontSize="11"/>
							<TextBox Text="{Binding NetworkUrl}"
                                     PlaceholderText="rtmp://192.168.1.20:1935/live/camera"
                                     FontSize="12" Padding="8,5"
                                     Background="{DynamicResource AppSurface2}"
                                     Foreground="{DynamicResource AppFg1}"
                                     BorderBrush="{DynamicResource AppBorder2}"
                                     CornerRadius="5"/>
							<TextBlock Text="{Binding NetworkError}"
                                       IsVisible="{Binding NetworkError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{StaticResource StatusErrorBrush}" FontSize="11" TextWrapping="Wrap"/>

							<TextBlock Text="Nom" Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppFg3}" FontSize="11"/>
							<TextBox Text="{Binding NetworkName}"
                                     PlaceholderText="{Binding NetworkNamePlaceholder}"
                                     FontSize="12" Padding="8,5"
                                     Background="{DynamicResource AppSurface2}"
                                     Foreground="{DynamicResource AppFg1}"
                                     BorderBrush="{DynamicResource AppBorder2}"
                                     CornerRadius="5"/>

							<TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppFg5}" FontSize="10"
                                       Text="La source reste noire tant que le flux n'émet pas, et se reconnecte seule s'il coupe."/>
						</StackPanel>

						<!-- Network scan -->
						<Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,12,0,6">
							<TextBlock Grid.Column="0" Text="Appareils RTMP du réseau"
                                       Foreground="{DynamicResource AppFg3}" FontSize="11"
                                       VerticalAlignment="Center"/>
							<Button Grid.Column="1"
                                    Command="{Binding ScanNetworkCommand}"
                                    IsVisible="{Binding CanScan}"
                                    Background="{DynamicResource AppSurface2}"
                                    BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                                    Foreground="{DynamicResource AppFg2}"
                                    Padding="10,4" CornerRadius="5" FontSize="11" Cursor="Hand"
                                    ToolTip.Tip="Cherche les appareils qui acceptent les connexions RTMP (port 1935)">
								<Panel>
									<TextBlock Text="Scan en cours…" IsVisible="{Binding IsScanning}"/>
									<TextBlock Text="Scanner le réseau" IsVisible="{Binding !IsScanning}"/>
								</Panel>
							</Button>
						</Grid>

						<Grid Grid.Row="2" RowDefinitions="*, Auto">
							<ListBox Grid.Row="0" Classes="source-list"
                                     ItemsSource="{Binding DiscoveredServers}"
                                     SelectedItem="{Binding SelectedServer}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="studioModels:DiscoveredRtmpServer">
										<Grid ColumnDefinitions="24, *" ToolTip.Tip="{Binding Server}">
											<Viewbox Grid.Column="0" Width="16" Height="16"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center">
												<Canvas Width="24" Height="24">
													<Path Data="M18.36 19.36a9 9 0 1 0 -12.72 0 M15.54 16.54a5 5 0 1 0 -7.08 0 M12 13a1 1 0 1 0 0 -2a1 1 0 0 0 0 2"
                                                          Stroke="{DynamicResource AppFg4}" StrokeThickness="2"
                                                          StrokeLineCap="Round" StrokeJoin="Round"/>
												</Canvas>
											</Viewbox>
											<StackPanel Grid.Column="1" Margin="8,0,8,0" Spacing="1"
                                                        VerticalAlignment="Center">
												<TextBlock Text="{Binding Title}"
                                                           FontSize="12" Foreground="{DynamicResource AppFg1}"
                                                           TextTrimming="CharacterEllipsis"/>
												<TextBlock Text="{Binding Server}"
                                                           FontSize="10" Foreground="{DynamicResource AppFg4}"
                                                           TextTrimming="CharacterEllipsis"/>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<TextBlock Grid.Row="1" Text="{Binding ScanMessage}"
                                       IsVisible="{Binding ScanMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource AppFg4}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
						</Grid>
						</Grid>

						<controls:MessageBar Grid.Row="1" Margin="0,8,0,0"
                                             Text="{Binding CatalogMessage.Text}"
                                             IsError="{Binding CatalogMessage.IsError}"
                                             DismissCommand="{Binding CatalogMessage.DismissCommand}"/>
					</Grid>

				</Grid>
			</Grid>

			<Rectangle Grid.Row="3" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Footer ── -->
			<Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto, 8, Auto" Margin="16,0">
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Actualisation…"
                               IsVisible="{Binding IsRefreshing}"
                               Foreground="{DynamicResource AppFg5}" FontSize="11"/>
					<TextBlock Text="Scan du réseau…"
                               IsVisible="{Binding IsScanning}"
                               Foreground="{DynamicResource AppFg5}" FontSize="11"/>
				</StackPanel>
				<Button Grid.Column="2" Classes="dlg-btn" Content="Annuler"
                        Command="{Binding CancelCommand}"
                        Background="{DynamicResource AppSurface2}"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                        Foreground="{DynamicResource AppFg3}"/>
				<Button Grid.Column="4" Classes="dlg-btn" Content="Ajouter à la scène"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding CanConfirm}"
                        Background="{DynamicResource AppAccentFill}" Foreground="{DynamicResource AppOnAccentFg}" BorderThickness="0"/>
			</Grid>

		</Grid>
	</Border>
</Window>
