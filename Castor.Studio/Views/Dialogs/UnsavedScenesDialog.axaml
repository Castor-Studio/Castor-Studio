<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CastorApplication.ViewModels.Shell"
        x:Class="CastorApplication.Views.Dialogs.UnsavedScenesDialog"
        x:DataType="vm:UnsavedScenesDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

	<!-- Enter saves, the safe default. Escape and the close button keep the app open. -->
	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
		<KeyBinding Gesture="Enter" Command="{Binding SaveCommand}"/>
	</Window.KeyBindings>

	<Border Background="{DynamicResource AppSurface}" CornerRadius="10"
            BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
		<Grid RowDefinitions="46, 1, Auto, 1, 54">

			<!-- ── Header (draggable) ── -->
			<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,0,10,0"
                  Background="Transparent"
                  PointerPressed="OnHeaderPointerPressed">
				<TextBlock Grid.Column="0" Text="{Binding Title}"
                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                           VerticalAlignment="Center"/>
				<Button Grid.Column="1" Command="{Binding CancelCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" CornerRadius="5" Cursor="Hand"
                        Foreground="{DynamicResource AppFg4}" FontSize="13"
                        AutomationProperties.Name="Fermer et rester dans l'application"
                        Content="✕"/>
			</Grid>

			<Rectangle Grid.Row="1" Fill="{DynamicResource AppBorder}"/>

			<TextBlock Grid.Row="2" Margin="16,14" Text="{Binding Message}" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource AppFg1}"/>

			<Rectangle Grid.Row="3" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Footer: cancel, quit without saving, save (default) ── -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
				<Button Classes="dlg-btn" Content="Annuler"
                        Command="{Binding CancelCommand}"
                        Background="{DynamicResource AppSurface2}"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                        Foreground="{DynamicResource AppFg3}"/>
				<Button Classes="dlg-btn" Content="Ne pas enregistrer"
                        Command="{Binding DontSaveCommand}"
                        Background="{DynamicResource AppSurface2}"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                        Foreground="{DynamicResource AppFg3}"/>
				<Button Classes="dlg-btn" Content="Enregistrer"
                        Command="{Binding SaveCommand}"
                        Background="{DynamicResource AppAccentFg}" Foreground="{DynamicResource AppOnAccentFg}" BorderThickness="0"/>
			</StackPanel>

		</Grid>
	</Border>
</Window>
