<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CastorApplication.ViewModels.Shell"
        x:Class="CastorApplication.Views.Dialogs.CrashNoticeDialog"
        x:DataType="vm:CrashNoticeDialogViewModel"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding DismissCommand}"/>
	</Window.KeyBindings>

	<Border Background="{DynamicResource AppSurface}" CornerRadius="10"
            BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
		<Grid RowDefinitions="46, 1, Auto, 1, 54">

			<!-- ── Header (draggable) ── -->
			<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,0,10,0"
                  Background="Transparent"
                  PointerPressed="OnHeaderPointerPressed">
				<TextBlock Grid.Column="0" Text="{Binding Title}"
                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                           VerticalAlignment="Center"/>
				<Button Grid.Column="1" Command="{Binding DismissCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" CornerRadius="5" Cursor="Hand"
                        Foreground="{DynamicResource AppFg4}" FontSize="13"
                        AutomationProperties.Name="Fermer"
                        Content="✕"/>
			</Grid>

			<Rectangle Grid.Row="1" Fill="{DynamicResource AppBorder}"/>

			<!-- ── What happened, and the file to attach, named in full ── -->
			<StackPanel Grid.Row="2" Margin="16,14" Spacing="10">
				<TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           FontSize="12" Foreground="{DynamicResource AppFg1}"/>
				<Border Background="{DynamicResource AppSurface2}" CornerRadius="5" Padding="10,8"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
					<SelectableTextBlock Text="{Binding ShownPath}" TextWrapping="Wrap"
                                         FontSize="11" Foreground="{DynamicResource AppFg3}"/>
				</Border>
			</StackPanel>

			<Rectangle Grid.Row="3" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Footer ── -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
				<Button Classes="dlg-btn" Content="Fermer"
                        Command="{Binding DismissCommand}"
                        Background="{DynamicResource AppSurface2}"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                        Foreground="{DynamicResource AppFg3}"/>
				<Button Classes="dlg-btn" Content="Afficher dans l'Explorateur"
                        Command="{Binding ShowFileCommand}"
                        Background="{DynamicResource AppAccentFill}" Foreground="{DynamicResource AppOnAccentFg}"
                        BorderThickness="0"/>
			</StackPanel>

		</Grid>
	</Border>
</Window>
