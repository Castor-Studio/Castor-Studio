<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CastorApplication.ViewModels.Studio"
        x:Class="CastorApplication.Views.Dialogs.CancelRecordingDialog"
        x:DataType="vm:CancelRecordingDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

	<!-- Pas de Entrée pour confirmer : la suppression est définitive, elle se choisit au clic.
	     Échap et la croix gardent l'enregistrement. -->
	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding DismissCommand}"/>
	</Window.KeyBindings>

	<Border Background="{DynamicResource AppSurface}" CornerRadius="10"
            BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
		<Grid RowDefinitions="46, 1, Auto, 1, 54">

			<!-- ── Header (déplaçable) ── -->
			<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,0,10,0"
                  Background="Transparent"
                  PointerPressed="OnHeaderPointerPressed">
				<TextBlock Grid.Column="0" Text="{Binding Title}"
                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                           VerticalAlignment="Center"/>
				<Button Grid.Column="1" Command="{Binding DismissCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" CornerRadius="5" Cursor="Hand"
                        Foreground="{DynamicResource AppFg4}" FontSize="13"
                        AutomationProperties.Name="Fermer et continuer l'enregistrement"
                        Content="✕"/>
			</Grid>

			<Rectangle Grid.Row="1" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Ce qui va disparaître : le fichier, nommé en entier ── -->
			<StackPanel Grid.Row="2" Margin="16,14" Spacing="10">
				<TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           FontSize="12" Foreground="{DynamicResource AppFg1}"/>
				<Border Background="{DynamicResource AppSurface2}" CornerRadius="5" Padding="10,8"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
					<SelectableTextBlock Text="{Binding OutputPath}" TextWrapping="Wrap"
                                         FontSize="11" Foreground="{DynamicResource AppFg3}"/>
				</Border>
			</StackPanel>

			<Rectangle Grid.Row="3" Fill="{DynamicResource AppBorder}"/>

			<!-- ── Pied : garder (par défaut) ou supprimer ── -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
				<Button Classes="dlg-btn" Content="Continuer l'enregistrement"
                        Command="{Binding DismissCommand}"
                        Background="{DynamicResource AppSurface2}"
                        BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                        Foreground="{DynamicResource AppFg3}"/>
				<Button Classes="dlg-btn" Content="Supprimer l'enregistrement"
                        Command="{Binding ConfirmCommand}"
                        Background="{DynamicResource StatusErrorBrush}" Foreground="{DynamicResource AppOnStatusFg}" BorderThickness="0"/>
			</StackPanel>

		</Grid>
	</Border>
</Window>
