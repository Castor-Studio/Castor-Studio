<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CastorApplication.Controls"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             x:Class="CastorApplication.Views.Multicam.MulticamAiBarView"
             x:DataType="vm:MulticamViewModel">

	<!-- Bottom of the panel card: the dock bar rounds the top (DockTheme.axaml).
	     Only the AI settings remain here: its suggestion shows on the tile of the
	     proposed scene (MulticamTileView), where the operator is already looking. -->
	<Border Background="{DynamicResource AppSurface}" CornerRadius="0,0,6,6" Padding="14,6,14,14"
	        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
		<StackPanel Spacing="8" VerticalAlignment="Center">
			<Grid ColumnDefinitions="Auto, Auto, *, Auto">

				<TextBlock Grid.Column="0" Text="IA" Margin="0,0,10,0"
                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                           VerticalAlignment="Center"/>

				<Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="2">
						<RadioButton Classes="segment" GroupName="MulticamAiMode" Content="Désactivée"
                                     IsChecked="{Binding IsAiOff, Mode=OneWay}"
                                     Command="{Binding SetAiOffCommand}"
                                     IsEnabled="{Binding !IsAiBusy}"/>
						<RadioButton Classes="segment" GroupName="MulticamAiMode" Content="Agent"
                                     IsChecked="{Binding IsAiAgent, Mode=OneWay}"
                                     Command="{Binding SetAiAgentCommand}"
                                     IsEnabled="{Binding !IsAiBusy}"
                                     ToolTip.Tip="L'IA suggère une scène sur sa tuile, vous la mettez à l'antenne"/>
						<RadioButton Classes="segment" GroupName="MulticamAiMode" Content="Auto"
                                     IsChecked="{Binding IsAiAuto, Mode=OneWay}"
                                     Command="{Binding SetAiAutoCommand}"
                                     IsEnabled="{Binding !IsAiBusy}"
                                     ToolTip.Tip="L'IA met elle-même à l'antenne la scène qu'elle choisit"/>
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" Margin="16,0"
                            VerticalAlignment="Center">
					<Ellipse Width="7" Height="7" Fill="{DynamicResource AppAccentFill}" VerticalAlignment="Center"
                             IsVisible="{Binding IsAiEnabled}"/>
					<TextBlock Text="{Binding AiStatusText}" Foreground="{DynamicResource AppFg3}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="14" VerticalAlignment="Center"/>
				</StackPanel>

				<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
					<TextBlock Text="Modèle" Foreground="{DynamicResource AppFg3}"
                               FontSize="14" VerticalAlignment="Center"/>
					<ComboBox MinWidth="164"
                              SelectedIndex="{Binding SelectedAiModelIndex}"
                              IsEnabled="{Binding !IsAiEnabled}"
                              ToolTip.Tip="Désactivez l'IA pour changer de modèle"
                              ToolTip.ShowOnDisabled="True"
                              FontSize="14">
						<ComboBoxItem Content="Football"/>
						<ComboBoxItem Content="Podcast"/>
					</ComboBox>
				</StackPanel>
			</Grid>

			<controls:MessageBar Text="{Binding AiError}"/>
		</StackPanel>
	</Border>
</UserControl>
