<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CastorApplication.Controls"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             x:Class="CastorApplication.Views.Multicam.MulticamAiBarView"
             x:DataType="vm:MulticamViewModel">

	<Border Background="{DynamicResource AppSurface3}" Padding="16,10">
	<StackPanel Spacing="8">
<Grid ColumnDefinitions="Auto, *, Auto">

	<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
		<TextBlock Text="IA :" Foreground="{DynamicResource AppFg3}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>

		<StackPanel Orientation="Horizontal" Spacing="6">
			<Button IsVisible="{Binding IsAiOff}"
                                Content="DÉSACTIVÉ"
                                Background="{DynamicResource AppBadgeBg}" Foreground="{DynamicResource AppFg3}"
                                BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                                Padding="12,6" CornerRadius="6"
                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
			<Button IsVisible="{Binding !IsAiOff}"
                                Content="DÉSACTIVÉ"
                                Command="{Binding SetAiOffCommand}"
                                IsEnabled="{Binding !IsAiBusy}"
                                Classes="ai-mode"/>

			<Button IsVisible="{Binding IsAiAgent}"
                                Content="MODE AGENT"
                                Classes="ai-active"/>
			<Button IsVisible="{Binding !IsAiAgent}"
                                Content="MODE AGENT"
                                Command="{Binding SetAiAgentCommand}"
                                IsEnabled="{Binding !IsAiBusy}"
                                Classes="ai-mode"/>

			<Button IsVisible="{Binding IsAiAuto}"
                                Content="MODE AUTO"
                                Classes="ai-active"/>
			<Button IsVisible="{Binding !IsAiAuto}"
                                Content="MODE AUTO"
                                Command="{Binding SetAiAutoCommand}"
                                IsEnabled="{Binding !IsAiBusy}"
                                Classes="ai-mode"/>
		</StackPanel>
	</StackPanel>

	<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
		<Ellipse Width="7" Height="7" Fill="{DynamicResource StatusOkBrush}" VerticalAlignment="Center"
                             IsVisible="{Binding IsAiEnabled}"/>
		<TextBlock Text="{Binding AiStatusText}" Foreground="{DynamicResource AppFg3}"
                               FontSize="12" VerticalAlignment="Center"/>
	</StackPanel>

	<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
		<TextBlock Text="Modèle IA :" Foreground="{DynamicResource AppFg4}"
                               FontSize="11" VerticalAlignment="Center"/>
		<ComboBox MinWidth="180"
                              SelectedIndex="{Binding SelectedAiModelIndex}"
                              IsEnabled="{Binding !IsAiEnabled}"
                              Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}" FontSize="12">
			<ComboBoxItem Content="Football"/>
			<ComboBoxItem Content="Podcast"/>
		</ComboBox>
	</StackPanel>

	</Grid>

		<Border IsVisible="{Binding HasAiSuggestion}" Background="{DynamicResource AppSurface2}"
				CornerRadius="6" Padding="10,7">
			<Grid ColumnDefinitions="*, Auto">
				<StackPanel Grid.Column="0" Spacing="2">
					<TextBlock Text="Suggestion IA" FontSize="10" Foreground="{DynamicResource AppFg4}"/>
					<TextBlock Text="{Binding AiSuggestionName}" FontSize="12"
							Foreground="{DynamicResource AppFg1}" FontWeight="SemiBold"/>
					<TextBlock Text="{Binding AiSuggestionConfidence, StringFormat='Confiance : {0}'}"
							FontSize="11" Foreground="{DynamicResource AppFg4}"/>
				</StackPanel>
				<Button Grid.Column="1" Content="APPLIQUER"
						Command="{Binding ApplyAiSuggestionCommand}"
						IsEnabled="{Binding !IsAiBusy}" VerticalAlignment="Center"
						Classes="ai-mode"/>
			</Grid>
		</Border>
		<TextBlock Text="Opération en cours..." IsVisible="{Binding IsAiBusy}"
				   FontSize="11" Foreground="{DynamicResource AppFg4}"/>
		<controls:MessageBar Text="{Binding AiError}"/>
	</StackPanel>
	</Border>
</UserControl>
