<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Multicam.MulticamTileView"
             xmlns:dockSettings="using:Dock.Settings"
             x:DataType="vm:MulticamSceneTile">

<!-- One color, one meaning: green for the scene chosen for output while nothing is running,
     red once it really goes out (stream or recording), blue for what the AI is doing, neutral
     for the rest. The border goes from 1 to 2 px while giving back 1 px of padding, so the
     video does not move a pixel when a tile changes state. -->
<Border Classes="tile"
        Classes.aiConsidered="{Binding IsAiConsidered}"
        Classes.aiPick="{Binding IsAiSelected}"
        Classes.onAir="{Binding IsOnAir}"
        Classes.live="{Binding IsOutputLive}"
        dockSettings:DockProperties.IsDragEnabled="False"
        dockSettings:DockProperties.IsDropEnabled="False"
        DoubleTapped="OnTileDoubleTapped"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnTileDragOver"
        DragDrop.Drop="OnTileDrop"
        ToolTip.Tip="Double-cliquez pour mettre cette scène à l'antenne"
        Background="{DynamicResource AppSurface}"
        CornerRadius="8" Margin="5"
        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="1">
	<Border.Styles>
		<Style Selector="Border.tile.aiConsidered">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentFg}"/>
		</Style>
		<Style Selector="Border.tile.aiPick">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentFg}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<!-- Declared after the suggestion: a suggested scene already on output reads as on output
		     first. -->
		<Style Selector="Border.tile.onAir">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusOkBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Border.tile.onAir.live">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>

		<!-- The band becomes the tally: a fill you spot on the wall without reading. -->
		<Style Selector="Border.tile.onAir Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusOkBrush}"/>
		</Style>
		<Style Selector="Border.tile.onAir.live Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
		<Style Selector="Border.tile.onAir Border.band TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>
		<Style Selector="Border.tile.onAir Border.band Ellipse">
			<Setter Property="Fill" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>

		<Style Selector="Border.tile.aiPick Border.foot">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>

		<Style Selector="Button.tile-action">
			<Setter Property="Background" Value="{DynamicResource AppAccentFg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppOnAccentFg}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="9,3"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Border.Styles>

	<Grid RowDefinitions="Auto, *, Auto, Auto">

		<!-- The title sits in a reserved band, never overlaid: the native surface is a Win32 child
		     window, which Windows composes above everything Avalonia paints. It is also the handle
		     for reordering scenes. -->
		<Border Grid.Row="0" Classes="band"
                Background="{DynamicResource AppSurface3}" Padding="12,7"
                CornerRadius="7,7,0,0"
                Cursor="SizeAll"
                PointerPressed="OnTileBandPointerPressed"
                ToolTip.Tip="Glissez pour réordonner les scènes">
			<Grid ColumnDefinitions="*, Auto">
				<TextBlock Grid.Column="0" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppFg1}"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                            IsVisible="{Binding IsOnAir}"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="Scène envoyée au stream et à l'enregistrement">
					<Ellipse Width="7" Height="7" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding OutputLabel}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
			<controls:StudioPreview Scene="{Binding Scene}"
                                    IsVisible="{Binding HasVideo}"
                                    ShowSceneName="False"
                                    PreviewRuntime="{Binding PreviewRuntime}"
                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                    Message="{Binding PreviewPlaceholderText}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

			<!-- A scene with no source starts no preview at all: rather than a black rectangle, it
			     says what it lacks. And that is one less native surface to run. -->
			<StackPanel IsVisible="{Binding !HasVideo}" Spacing="4" Margin="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Aucune source vidéo" HorizontalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource VideoFgBrush}"/>
				<TextBlock Text="Ajoutez-en une dans l'onglet Scènes."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource VideoFgMutedBrush}"/>
			</StackPanel>
		</Panel>

		<!-- What the AI knows of the scene while reading it: the filmed person's microphone and,
		     in podcast mode, their role. Outside the preview: the native surface would cover it. -->
		<Border Grid.Row="2" IsVisible="{Binding ShowAiSetup}"
                Background="{DynamicResource AppSurface3}" Padding="8,5,8,0">
			<Grid ColumnDefinitions="*, Auto">
				<ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          IsVisible="{Binding ShowAiMicrophone}"
                          ItemsSource="{Binding AiMicrophoneOptions}"
                          SelectedItem="{Binding AiMicrophone}"
                          ToolTip.Tip="Micro de la personne filmée, écouté par l'IA"
                          Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}" FontSize="11"/>
				<ComboBox Grid.Column="1" MinWidth="120" Margin="6,0,0,0"
                          IsVisible="{Binding ShowAiRole}"
                          ItemsSource="{Binding AiRoleOptions}"
                          SelectedItem="{Binding AiRole}"
                          ToolTip.Tip="Rôle de la personne filmée dans le podcast"
                          Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}" FontSize="11"/>
			</Grid>
		</Border>

		<!-- The footer belongs to the AI: the pill including the scene in the analysis and, in
		     agent mode, the suggestion to confirm, where the proposed scene is. -->
		<Border Grid.Row="3" Classes="foot"
                Background="{DynamicResource AppSurface3}" Padding="12,5,8,5" MinHeight="34"
                CornerRadius="0,0,7,7">
			<Grid ColumnDefinitions="*, Auto, Auto">
				<TextBlock Grid.Column="0" Text="{Binding SourceCountText}"
                           IsVisible="{Binding !IsAiSelected}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppFg4}" FontSize="11"/>

				<TextBlock Grid.Column="0"
                           IsVisible="{Binding IsAiSelected}"
                           Text="{Binding $parent[ItemsControl].((vm:MulticamViewModel)DataContext).AiSuggestionConfidence, StringFormat='Suggérée ({0})', FallbackValue='Suggérée'}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppAccentFg}" FontSize="11" FontWeight="SemiBold"/>
				<Button Grid.Column="1" Classes="tile-action"
                        IsVisible="{Binding IsAiSelected}"
                        Content="Mettre à l'antenne"
                        Command="{Binding $parent[ItemsControl].((vm:MulticamViewModel)DataContext).ApplyAiSuggestionCommand, FallbackValue={x:Null}}"
                        IsEnabled="{Binding !$parent[ItemsControl].((vm:MulticamViewModel)DataContext).IsAiBusy, FallbackValue=False}"
                        Margin="8,0,0,0" VerticalAlignment="Center"/>

				<ToggleButton Grid.Column="2" IsChecked="{Binding IsSelected}"
                              Classes="ai-pick" VerticalAlignment="Center"
                              Margin="6,0,0,0"
                              Content="IA"
                              ToolTip.Tip="Inclure cette scène dans l'analyse de l'IA"/>
			</Grid>
		</Border>
	</Grid>
</Border>

</UserControl>
