<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Multicam.MulticamTileView"
             xmlns:dockSettings="using:Dock.Settings"
             x:DataType="vm:MulticamSceneTile">

<!-- Trois couleurs, trois sens : rouge pour la scène à l'antenne, bleu pour ce que fait l'IA,
     neutre pour le reste. La bordure passe de 1 à 2 px en rendant 1 px de marge intérieure,
     pour que la vidéo ne bouge pas d'un pixel quand une tuile change d'état. -->
<Border Classes="tile"
        Classes.aiConsidered="{Binding IsAiConsidered}"
        Classes.aiPick="{Binding IsAiSelected}"
        Classes.onAir="{Binding IsOnAir}"
        dockSettings:DockProperties.IsDragEnabled="False"
        dockSettings:DockProperties.IsDropEnabled="False"
        DoubleTapped="OnTileDoubleTapped"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnTileDragOver"
        DragDrop.Drop="OnTileDrop"
        ToolTip.Tip="Double-cliquez pour mettre cette scène à l'antenne"
        Background="{DynamicResource AppSurface}"
        CornerRadius="8" Margin="5"
        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="1">
	<Border.Styles>
		<Style Selector="Border.tile.aiConsidered">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentFg}"/>
		</Style>
		<Style Selector="Border.tile.aiPick">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentFg}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<!-- Déclaré après la suggestion : une scène suggérée qui est déjà à l'antenne
		     se lit d'abord comme à l'antenne. -->
		<Style Selector="Border.tile.onAir">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<!-- Le bandeau devient le tally : un aplat rouge qu'on repère sur le mur sans lire. -->
		<Style Selector="Border.tile.onAir Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
		<Style Selector="Border.tile.onAir Border.band TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>

		<Style Selector="Border.tile.aiPick Border.foot">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>

		<Style Selector="Button.tile-action">
			<Setter Property="Background" Value="{DynamicResource AppAccentFg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppOnAccentFg}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="9,3"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Border.Styles>

	<Grid RowDefinitions="Auto, *, Auto">

		<!-- Le titre tient dans un bandeau réservé, jamais en surimpression : la surface
		     native est une fenêtre enfant Win32, Windows la compose au-dessus de tout ce
		     qu'Avalonia peint. C'est aussi la poignée pour réordonner les scènes. -->
		<Border Grid.Row="0" Classes="band"
                Background="{DynamicResource AppSurface3}" Padding="12,7"
                CornerRadius="7,7,0,0"
                Cursor="SizeAll"
                PointerPressed="OnTileBandPointerPressed"
                ToolTip.Tip="Glissez pour réordonner les scènes">
			<Grid ColumnDefinitions="*, Auto">
				<TextBlock Grid.Column="0" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppFg1}"/>
				<TextBlock Grid.Column="1" Text="À l'antenne"
                           IsVisible="{Binding IsOnAir}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
			<controls:StudioPreview Scene="{Binding Scene}"
                                    IsVisible="{Binding HasVideo}"
                                    ShowSceneName="False"
                                    PreviewRuntime="{Binding PreviewRuntime}"
                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                    Message="{Binding PreviewPlaceholderText}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

			<!-- Une scène sans source ne lance pas d'aperçu du tout : plutôt qu'un
			     rectangle noir, elle dit ce qui lui manque. Et c'est une surface native
			     de moins à faire tourner. -->
			<StackPanel IsVisible="{Binding !HasVideo}" Spacing="4" Margin="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Aucune source vidéo" HorizontalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource VideoFgBrush}"/>
				<TextBlock Text="Ajoutez-en une dans l'onglet Scènes."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource VideoFgMutedBrush}"/>
			</StackPanel>
		</Panel>

		<!-- Le pied appartient à l'IA : la pastille qui inclut la scène dans l'analyse et,
		     en mode agent, la suggestion à valider, là où se trouve la scène proposée. -->
		<Border Grid.Row="2" Classes="foot"
                Background="{DynamicResource AppSurface3}" Padding="12,5,8,5" MinHeight="34"
                CornerRadius="0,0,7,7">
			<Grid ColumnDefinitions="*, Auto, Auto">
				<TextBlock Grid.Column="0" Text="{Binding SourceCountText}"
                           IsVisible="{Binding !IsAiSelected}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppFg4}" FontSize="11"/>

				<TextBlock Grid.Column="0"
                           IsVisible="{Binding IsAiSelected}"
                           Text="{Binding $parent[ItemsControl].((vm:MulticamViewModel)DataContext).AiSuggestionConfidence, StringFormat='Suggérée ({0})', FallbackValue='Suggérée'}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppAccentFg}" FontSize="11" FontWeight="SemiBold"/>
				<Button Grid.Column="1" Classes="tile-action"
                        IsVisible="{Binding IsAiSelected}"
                        Content="Mettre à l'antenne"
                        Command="{Binding $parent[ItemsControl].((vm:MulticamViewModel)DataContext).ApplyAiSuggestionCommand, FallbackValue={x:Null}}"
                        IsEnabled="{Binding !$parent[ItemsControl].((vm:MulticamViewModel)DataContext).IsAiBusy, FallbackValue=False}"
                        Margin="8,0,0,0" VerticalAlignment="Center"/>

				<ToggleButton Grid.Column="2" IsChecked="{Binding IsSelected}"
                              Classes="ai-pick" VerticalAlignment="Center"
                              Margin="6,0,0,0"
                              Content="IA"
                              ToolTip.Tip="Inclure cette scène dans l'analyse de l'IA"/>
			</Grid>
		</Border>
	</Grid>
</Border>

</UserControl>
