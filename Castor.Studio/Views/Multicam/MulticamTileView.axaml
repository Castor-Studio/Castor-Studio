<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Multicam.MulticamTileView"
             xmlns:dockSettings="using:Dock.Settings"
             x:DataType="vm:MulticamSceneTile">

<!-- Une couleur, un sens : vert pour la scène choisie pour la sortie tant que rien ne tourne,
     rouge dès qu'elle part vraiment (stream ou enregistrement), bleu pour ce que fait l'IA,
     neutre pour le reste. La bordure passe de 1 à 2 px en rendant 1 px de marge intérieure,
     pour que la vidéo ne bouge pas d'un pixel quand une tuile change d'état. -->
<Border Classes="tile"
        Classes.aiConsidered="{Binding IsAiConsidered}"
        Classes.aiPick="{Binding IsAiSelected}"
        Classes.onAir="{Binding IsOnAir}"
        Classes.live="{Binding IsOutputLive}"
        dockSettings:DockProperties.IsDragEnabled="False"
        dockSettings:DockProperties.IsDropEnabled="False"
        DoubleTapped="OnTileDoubleTapped"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnTileDragOver"
        DragDrop.Drop="OnTileDrop"
        ToolTip.Tip="Double-cliquez pour mettre cette scène à l'antenne"
        Background="{DynamicResource AppChromeBg}"
        CornerRadius="8" Margin="5">
	<Border.Styles>
		<Style Selector="Border.tile">
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="1"/>
		</Style>
		<Style Selector="Border.band">
			<Setter Property="Background" Value="{DynamicResource AppSurface3}"/>
		</Style>
		<Style Selector="Border.band TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
		</Style>
		<Style Selector="Border.foot">
			<Setter Property="Background" Value="{DynamicResource AppSurface3}"/>
		</Style>
		<Style Selector="Border.tile.aiConsidered">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentFill}"/>
		</Style>
		<Style Selector="Border.tile.aiPick">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentFill}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<!-- Déclarés après la suggestion : une scène suggérée qui est déjà en sortie se lit
		     d'abord comme en sortie. -->
		<Style Selector="Border.tile.onAir">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusOkBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Border.tile.onAir.live">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>

		<!-- Le bandeau devient le tally : un aplat qu'on repère sur le mur sans lire. -->
		<Style Selector="Border.tile.onAir Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusOkBrush}"/>
		</Style>
		<Style Selector="Border.tile.onAir.live Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
		<Style Selector="Border.tile.onAir Border.band TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>
		<Style Selector="Border.tile.onAir Border.band Ellipse">
			<Setter Property="Fill" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>

		<Style Selector="Border.tile.aiPick Border.foot">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>

		<Style Selector="Button.tile-action">
			<Setter Property="Background" Value="{DynamicResource AppAccentFill}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppOnAccentFg}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="9,3"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Border.Styles>

	<Grid RowDefinitions="Auto, *, Auto, Auto">

		<!-- Le titre tient dans un bandeau réservé, jamais en surimpression : la surface
		     native est une fenêtre enfant Win32, Windows la compose au-dessus de tout ce
		     qu'Avalonia peint. C'est aussi la poignée pour réordonner les scènes. -->
		<Border Grid.Row="0" Classes="band"
                Padding="16,12"
                CornerRadius="7,7,0,0"
                Cursor="SizeAll"
                PointerPressed="OnTileBandPointerPressed"
                ToolTip.Tip="Glissez pour réordonner les scènes">
			<Grid ColumnDefinitions="*, Auto">
				<TextBlock Grid.Column="0" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                            IsVisible="{Binding IsOnAir}"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="Scène envoyée au stream et à l'enregistrement">
					<Ellipse Width="7" Height="7" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding OutputLabel}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
			<controls:StudioPreview Scene="{Binding Scene}"
                                    IsVisible="{Binding HasVideo}"
                                    ShowSceneName="False"
                                    PreviewRuntime="{Binding PreviewRuntime}"
                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                    Message="{Binding PreviewPlaceholderText}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

			<!-- Une scène sans source ne lance pas d'aperçu du tout : plutôt qu'un
			     rectangle noir, elle dit ce qui lui manque. Et c'est une surface native
			     de moins à faire tourner. -->
			<StackPanel IsVisible="{Binding !HasVideo}" Spacing="4" Margin="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Aucune source vidéo" HorizontalAlignment="Center"
                           FontSize="13.5" FontWeight="Bold"
                           Foreground="{DynamicResource VideoFgBrush}"/>
				<TextBlock Text="Ajoutez-en une dans l'onglet Scènes."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="12.5"
                           Foreground="{DynamicResource VideoFgMutedBrush}"/>
			</StackPanel>
		</Panel>

		<!-- Ce que l'IA sait de la scène, tant qu'elle la lit : le micro de la personne filmée et,
		     en podcast, son rôle. Hors de l'aperçu : la surface native passerait par-dessus. -->
		<Border Grid.Row="2" IsVisible="{Binding ShowAiSetup}"
                Background="{DynamicResource AppSurface3}" Padding="8,5,8,0">
			<Grid ColumnDefinitions="*, Auto">
				<ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          IsVisible="{Binding ShowAiMicrophone}"
                          ItemsSource="{Binding AiMicrophoneOptions}"
                          SelectedItem="{Binding AiMicrophone}"
                          ToolTip.Tip="Micro de la personne filmée, écouté par l'IA"
                          FontSize="11"/>
				<ComboBox Grid.Column="1" MinWidth="120" Margin="6,0,0,0"
                          IsVisible="{Binding ShowAiRole}"
                          ItemsSource="{Binding AiRoleOptions}"
                          SelectedItem="{Binding AiRole}"
                          ToolTip.Tip="Rôle de la personne filmée dans le podcast"
                          FontSize="11"/>
			</Grid>
		</Border>

		<!-- Le pied appartient à l'IA : la pastille qui inclut la scène dans l'analyse et,
		     en mode agent, la suggestion à valider, là où se trouve la scène proposée. -->
		<Border Grid.Row="3" Classes="foot"
                Padding="16,8" MinHeight="34"
                CornerRadius="0,0,7,7">
			<Grid ColumnDefinitions="*, Auto, Auto">
				<TextBlock Grid.Column="0" Text="{Binding SourceCountText}"
                           IsVisible="{Binding !IsAiSelected}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppFg5}" FontSize="12.5"/>

				<TextBlock Grid.Column="0"
                           IsVisible="{Binding IsAiSelected}"
                           Text="{Binding $parent[ItemsControl].((vm:MulticamViewModel)DataContext).AiSuggestionConfidence, StringFormat='Suggérée ({0})', FallbackValue='Suggérée'}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppAccentFg}" FontSize="11" FontWeight="SemiBold"/>
				<Button Grid.Column="1" Classes="tile-action"
                        IsVisible="{Binding IsAiSelected}"
                        Content="Mettre à l'antenne"
                        Command="{Binding $parent[ItemsControl].((vm:MulticamViewModel)DataContext).ApplyAiSuggestionCommand, FallbackValue={x:Null}}"
                        IsEnabled="{Binding !$parent[ItemsControl].((vm:MulticamViewModel)DataContext).IsAiBusy, FallbackValue=False}"
                        Margin="8,0,0,0" VerticalAlignment="Center"/>

				<ToggleButton Grid.Column="2" IsChecked="{Binding IsSelected}"
                              Classes="ai-pick" VerticalAlignment="Center"
                              Margin="6,0,0,0"
                              ToolTip.Tip="Inclure cette scène dans l'analyse de l'IA">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Viewbox Width="16" Height="16" VerticalAlignment="Center">
							<Canvas Width="24" Height="24">
								<Path Data="M10 3l1.9 5.1L17 10l-5.1 1.9L10 17l-1.9-5.1L3 10l5.1-1.9z M18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9z"
                                      Fill="{Binding $parent[ToggleButton].Foreground}"/>
							</Canvas>
						</Viewbox>
						<TextBlock Text="Sélection IA" VerticalAlignment="Center"/>
					</StackPanel>
				</ToggleButton>
			</Grid>
		</Border>
	</Grid>
</Border>

</UserControl>
