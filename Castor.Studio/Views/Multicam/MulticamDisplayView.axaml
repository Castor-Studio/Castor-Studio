<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             xmlns:mcViews="using:CastorApplication.Views.Multicam"
             x:Class="CastorApplication.Views.Multicam.MulticamDisplayView"
             x:DataType="vm:MulticamViewModel">

	<Grid RowDefinitions="Auto, *">

		<!-- Les commandes vivent dans le panneau, pas dans l'en-tête de la page : quand
		     l'aperçu est sorti dans sa propre fenêtre, le choix du mode doit partir avec
		     lui, sinon on se retrouve avec un affichage qu'on ne peut plus changer. -->
		<Border Grid.Row="0" Background="{DynamicResource AppSurface3}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
                Padding="10,7">
			<Grid ColumnDefinitions="Auto, *, Auto">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<Border Background="{DynamicResource AppBadgeBg}" CornerRadius="6" Padding="3">
					<StackPanel Orientation="Horizontal" Spacing="2">
						<Button IsVisible="{Binding IsGridLayout}" Content="GRILLE" Classes="ai-active"/>
						<Button IsVisible="{Binding !IsGridLayout}" Content="GRILLE"
                                Command="{Binding UseGridLayoutCommand}" Classes="ai-mode"/>
						<Button IsVisible="{Binding IsSpotlightLayout}" Content="SPOTLIGHT" Classes="ai-active"/>
						<Button IsVisible="{Binding !IsSpotlightLayout}" Content="SPOTLIGHT"
                                Command="{Binding UseSpotlightLayoutCommand}" Classes="ai-mode"/>
					</StackPanel>
				</Border>

				<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsGridLayout}">
					<TextBlock Text="Colonnes :" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource AppFg4}"/>
					<ComboBox SelectedIndex="{Binding ColumnChoice}" Width="88"
                              VerticalAlignment="Center">
						<ComboBoxItem Content="Auto"/>
						<ComboBoxItem Content="1"/>
						<ComboBoxItem Content="2"/>
						<ComboBoxItem Content="3"/>
						<ComboBoxItem Content="4"/>
					</ComboBox>
				</StackPanel>
			</StackPanel>

				<Border Grid.Column="1" Background="{DynamicResource AppBadgeBg}" CornerRadius="10"
                        Padding="8,3" HorizontalAlignment="Left" Margin="10,0,0,0"
                        VerticalAlignment="Center">
					<TextBlock Text="{Binding Scenes.Count, StringFormat='{}{0} scènes'}"
                               FontSize="11" Foreground="{DynamicResource AppFg4}"/>
				</Border>

				<Button Grid.Column="2" Content="ACTUALISER"
                        Command="{Binding RefreshTilesCommand}"
                        Background="{DynamicResource AppAccentBg}" Foreground="{DynamicResource AppAccentFg}"
                        BorderThickness="0" Padding="12,6" CornerRadius="6"
                        FontSize="11" FontWeight="SemiBold"
                        VerticalAlignment="Center" Cursor="Hand"/>
			</Grid>
		</Border>

		<Panel Grid.Row="1">
<!-- Grille : toutes les scènes à la même taille. -->
<ItemsControl IsVisible="{Binding IsGridLayout}" ItemsSource="{Binding Tiles}">
	<ItemsControl.ItemsPanel>
		<ItemsPanelTemplate>
			<UniformGrid Columns="{Binding GridColumns}"/>
		</ItemsPanelTemplate>
	</ItemsControl.ItemsPanel>
		<ItemsControl.ItemTemplate>
			<DataTemplate x:DataType="vm:MulticamSceneTile">
				<mcViews:MulticamTileView/>
			</DataTemplate>
		</ItemsControl.ItemTemplate>
</ItemsControl>

<!-- Spotlight : la scène à l'antenne en grand, les autres en bande.
     Elle est rendue sur une surface qui lui est propre plutôt qu'en
     empruntant sa tuile : un aperçu par fenêtre est précisément ce que
     le runtime sait faire, et ça évite de tenir à jour une seconde
     collection filtrée. -->
<Grid RowDefinitions="*, Auto" IsVisible="{Binding IsSpotlightLayout}">
	<Border Grid.Row="0"
                        Background="{DynamicResource AppSurface}"
                        CornerRadius="8" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource StatusErrorBrush}" BorderThickness="2">
		<Grid RowDefinitions="Auto, *">
			<Border Grid.Row="0" Background="{DynamicResource AppBg}" Padding="10,6" CornerRadius="7,7,0,0">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<Border Background="{DynamicResource StatusErrorBrush}"
                                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                                        IsVisible="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNotNull}}">
						<TextBlock Text="LIVE" Foreground="{DynamicResource AppOnStatusFg}"
                                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
					</Border>
					<TextBlock Text="{Binding SpotlightScene.Name}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppFg1}"/>
				</StackPanel>
			</Border>

			<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
				<controls:StudioPreview Scene="{Binding SpotlightScene}"
                                                    PreviewRuntime="{Binding PreviewRuntime}"
                                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                                    Message="{Binding SpotlightPlaceholderText}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
			</Panel>
		</Grid>
	</Border>

	<ScrollViewer Grid.Row="1" Height="170" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
		<ItemsControl ItemsSource="{Binding Tiles}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:MulticamSceneTile">
					<mcViews:MulticamTileView Width="240" Margin="0,0,10,0"/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</ScrollViewer>
</Grid>
		</Panel>
	</Grid>
</UserControl>
