<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             xmlns:mcViews="using:CastorApplication.Views.Multicam"
             x:Class="CastorApplication.Views.Multicam.MulticamDisplayView"
             x:DataType="vm:MulticamViewModel">

	<UserControl.Styles>
		<!-- The large Spotlight image has the same tally as the tiles: green while the scene is
		     only selected, red once it is streamed or recorded. -->
		<Style Selector="Border.spotlight.onAir">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusOkBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Border.spotlight.onAir.live">
			<Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
		<Style Selector="Border.spotlight.onAir Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusOkBrush}"/>
		</Style>
		<Style Selector="Border.spotlight.onAir.live Border.band">
			<Setter Property="Background" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
		<Style Selector="Border.spotlight.onAir Border.band TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>
		<Style Selector="Border.spotlight.onAir Border.band Ellipse">
			<Setter Property="Fill" Value="{DynamicResource AppOnStatusFg}"/>
		</Style>

		<!-- Output marker of the toolbar: the outgoing scene, readable without searching for its
		     tile in the wall, with the same color code as the tally. -->
		<Style Selector="Border.output-chip">
			<Setter Property="Background" Value="{DynamicResource AppLiveBg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppLiveBorder}"/>
		</Style>
		<Style Selector="Border.output-chip TextBlock.state">
			<Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}"/>
		</Style>
		<Style Selector="Border.output-chip Ellipse">
			<Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/>
		</Style>
		<Style Selector="Border.output-chip.live">
			<Setter Property="Background" Value="{DynamicResource AppStopBg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppStopBorder}"/>
		</Style>
		<Style Selector="Border.output-chip.live TextBlock.state">
			<Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
		<Style Selector="Border.output-chip.live Ellipse">
			<Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}"/>
		</Style>
	</UserControl.Styles>

	<!-- Bottom of the panel card: the dock bar rounds the top (DockTheme.axaml). -->
	<Border Background="{DynamicResource AppSurface}" CornerRadius="0,0,8,8" ClipToBounds="True"
	        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,1,1">
	<Grid RowDefinitions="Auto, *">

		<!-- The controls live in the panel, not the page header: when the preview is moved out to
		     its own window, the mode choice must go with it, or you are left with a display you can
		     no longer change. -->
		<Border Grid.Row="0" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
                Padding="10,8">
			<Grid ColumnDefinitions="Auto, Auto, *, Auto">
				<Border Grid.Column="0" Classes="segmented" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="2">
						<RadioButton Classes="segment" GroupName="MulticamLayout" Content="Grille"
                                     IsChecked="{Binding IsGridLayout, Mode=OneWay}"
                                     Command="{Binding UseGridLayoutCommand}"
                                     ToolTip.Tip="Toutes les scènes à la même taille"/>
						<RadioButton Classes="segment" GroupName="MulticamLayout" Content="Spotlight"
                                     IsChecked="{Binding IsSpotlightLayout, Mode=OneWay}"
                                     Command="{Binding UseSpotlightLayoutCommand}"
                                     ToolTip.Tip="La scène à l'antenne en grand, les autres en bande"/>
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                            VerticalAlignment="Center" IsVisible="{Binding IsGridLayout}">
					<TextBlock Text="Colonnes" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource AppFg3}"/>
					<ComboBox SelectedIndex="{Binding ColumnChoice}" Width="88"
                              VerticalAlignment="Center"
                              Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}">
						<ComboBoxItem Content="Auto"/>
						<ComboBoxItem Content="1"/>
						<ComboBoxItem Content="2"/>
						<ComboBoxItem Content="3"/>
						<ComboBoxItem Content="4"/>
					</ComboBox>
				</StackPanel>

				<Border Grid.Column="2" Classes="output-chip" Classes.live="{Binding IsOutputLive}"
                        IsVisible="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNotNull}}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,8,0"
                        BorderThickness="1" CornerRadius="12" Padding="10,4"
                        ToolTip.Tip="Scène envoyée au stream et à l'enregistrement">
					<StackPanel Orientation="Horizontal" Spacing="7">
						<Ellipse Width="7" Height="7" VerticalAlignment="Center"/>
						<TextBlock Classes="state" Text="{Binding OutputLabel}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
						<Rectangle Width="1" Height="12" Fill="{DynamicResource AppBorder2}" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding SpotlightScene.Name, FallbackValue=''}"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppFg1}"/>
					</StackPanel>
				</Border>

				<Button Grid.Column="3" Command="{Binding RefreshTilesCommand}"
                        Background="Transparent" BorderThickness="0"
                        Width="30" Height="30" Padding="0" CornerRadius="6" Cursor="Hand"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Actualiser les aperçus"
                        AutomationProperties.Name="Actualiser les aperçus">
					<Viewbox Width="15" Height="15">
						<Canvas Width="24" Height="24">
							<Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"
                                  Stroke="{DynamicResource AppFg3}" StrokeThickness="2"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
						</Canvas>
					</Viewbox>
				</Button>
			</Grid>
		</Border>

		<!-- The wall: 5 px around the area + 5 px around each tile, so the same 10 px gap between
		     two tiles as between a tile and the edge. -->
		<Panel Grid.Row="1" Background="{DynamicResource AppBg}">

			<StackPanel IsVisible="{Binding !HasScenes}" Spacing="4" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Aucune scène pour l'instant" HorizontalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppFg1}"/>
				<TextBlock Text="Créez une scène dans l'onglet Scènes : elle apparaîtra ici, en direct."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" Foreground="{DynamicResource AppFg4}"/>
			</StackPanel>

			<!-- Grid: all scenes at the same size. -->
			<ItemsControl IsVisible="{Binding IsGridLayout}" ItemsSource="{Binding Tiles}" Margin="5">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="{Binding GridColumns}"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:MulticamSceneTile">
						<mcViews:MulticamTileView/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Spotlight: the on-air scene large, the others in a strip. It renders on a surface of
			     its own rather than borrowing its tile: one preview per window is precisely what the
			     runtime can do, and it avoids maintaining a second filtered collection. -->
			<Grid RowDefinitions="*, Auto" Margin="5" IsVisible="{Binding IsSpotlightLayout}">
				<Border Grid.Row="0" Classes="spotlight"
                        Classes.onAir="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Classes.live="{Binding IsOutputLive}"
                        Background="{DynamicResource AppSurface}"
                        CornerRadius="8" Margin="5"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="1">
					<Grid RowDefinitions="Auto, *">
						<Border Grid.Row="0" Classes="band"
                                Background="{DynamicResource AppSurface3}" Padding="14,8"
                                CornerRadius="7,7,0,0">
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Grid.Column="0" Text="{Binding SpotlightScene.Name, FallbackValue=''}"
                                           IsVisible="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppFg1}"/>
								<TextBlock Grid.Column="0" Text="Aucune scène en sortie"
                                           IsVisible="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNull}}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppFg4}"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Margin="12,0,0,0" VerticalAlignment="Center">
									<Ellipse Width="8" Height="8" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding OutputLabel}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
						</Border>

						<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
							<controls:StudioPreview Scene="{Binding SpotlightScene}"
                                                    ShowSceneName="False"
                                                    PreviewRuntime="{Binding PreviewRuntime}"
                                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                                    Message="{Binding SpotlightPlaceholderText}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
						</Panel>
					</Grid>
				</Border>

				<ScrollViewer Grid.Row="1" Height="190" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding Tiles}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:MulticamSceneTile">
								<mcViews:MulticamTileView Width="250"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Panel>
	</Grid>
	</Border>
</UserControl>
