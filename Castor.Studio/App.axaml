<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CastorApplication.App"
             xmlns:local="using:CastorApplication"
             RequestedThemeVariant="Dark">

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Resources>
		<ResourceDictionary>
			<!-- ═══ COULEURS FIXES DE STATUT ═══ -->
			<SolidColorBrush x:Key="StatusOkBrush" Color="#34D399" />
			<SolidColorBrush x:Key="StatusWarningBrush" Color="#FBBF24" />
			<SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171" />
			<SolidColorBrush x:Key="StatusInactiveBrush" Color="#6B7280" />
			<SolidColorBrush x:Key="StatusLiveBrush" Color="#10B981" />
			<SolidColorBrush x:Key="StatusRecBrush" Color="#EF4444" />

			<!-- ═══ DICTIONNAIRES DE THÈMES ═══ -->
			<ResourceDictionary.ThemeDictionaries>

				<!-- ═══ THÈME SOMBRE ═══ -->
				<ResourceDictionary x:Key="Dark">
					<!-- Fonds -->
					<SolidColorBrush x:Key="AppBg"          Color="#0b0b12"/>
					<SolidColorBrush x:Key="AppSurface"     Color="#13131c"/>
					<SolidColorBrush x:Key="AppSurface2"    Color="#1c1c28"/>
					<SolidColorBrush x:Key="AppSurface3"    Color="#09090f"/>
					<SolidColorBrush x:Key="AppVeryDarkBg"  Color="#07070d"/>
					<SolidColorBrush x:Key="AppNavBadgeBg"  Color="#24242f"/>
					<SolidColorBrush x:Key="AppBadgeBg"     Color="#24242f"/>
					<SolidColorBrush x:Key="AppNavHoverBg"  Color="#1c1c28"/>
					<SolidColorBrush x:Key="AppAccentBg"    Color="#162040"/>
					<SolidColorBrush x:Key="AppAccentBg2"   Color="#141c30"/>
					<!-- Bordures -->
					<SolidColorBrush x:Key="AppBorder"      Color="#2a2a38"/>
					<SolidColorBrush x:Key="AppBorder2"     Color="#36364a"/>
					<!-- Textes -->
					<SolidColorBrush x:Key="AppFg1"         Color="#eaeaf0"/>
					<SolidColorBrush x:Key="AppFg2"         Color="#ccccd8"/>
					<SolidColorBrush x:Key="AppFg3"         Color="#8888a0"/>
					<SolidColorBrush x:Key="AppFg4"         Color="#5c5c72"/>
					<SolidColorBrush x:Key="AppFg5"         Color="#3c3c4e"/>
					<SolidColorBrush x:Key="AppFg6"         Color="#36364a"/>
					<!-- Boutons d'action -->
					<SolidColorBrush x:Key="AppLiveBg"      Color="#0e2420"/>
					<SolidColorBrush x:Key="AppLiveBorder"  Color="#142e25"/>
					<SolidColorBrush x:Key="AppStopBg"      Color="#251218"/>
					<SolidColorBrush x:Key="AppStopBorder"  Color="#2f1820"/>
					<SolidColorBrush x:Key="AppRecBg"       Color="#2d1212"/>
					<SolidColorBrush x:Key="AppRecBorder"   Color="#3d1a1a"/>
				</ResourceDictionary>

				<!-- ═══ THÈME CLAIR ═══ -->
				<ResourceDictionary x:Key="Light">
					<!-- Fonds -->
					<SolidColorBrush x:Key="AppBg"          Color="#eeeef6"/>
					<SolidColorBrush x:Key="AppSurface"     Color="#f6f6fc"/>
					<SolidColorBrush x:Key="AppSurface2"    Color="#eaeaf4"/>
					<SolidColorBrush x:Key="AppSurface3"    Color="#e2e2ee"/>
					<SolidColorBrush x:Key="AppVeryDarkBg"  Color="#d4d4e8"/>
					<SolidColorBrush x:Key="AppNavBadgeBg"  Color="#2a2a3a"/>
					<SolidColorBrush x:Key="AppBadgeBg"     Color="#dcdcee"/>
					<SolidColorBrush x:Key="AppNavHoverBg"  Color="#e0e0f0"/>
					<SolidColorBrush x:Key="AppAccentBg"    Color="#dce8ff"/>
					<SolidColorBrush x:Key="AppAccentBg2"   Color="#e2ebff"/>
					<!-- Bordures -->
					<SolidColorBrush x:Key="AppBorder"      Color="#ccccde"/>
					<SolidColorBrush x:Key="AppBorder2"     Color="#bcbcd2"/>
					<!-- Textes -->
					<SolidColorBrush x:Key="AppFg1"         Color="#18182a"/>
					<SolidColorBrush x:Key="AppFg2"         Color="#282844"/>
					<SolidColorBrush x:Key="AppFg3"         Color="#484888"/>
					<SolidColorBrush x:Key="AppFg4"         Color="#6868a0"/>
					<SolidColorBrush x:Key="AppFg5"         Color="#8888b8"/>
					<SolidColorBrush x:Key="AppFg6"         Color="#a0a0c0"/>
					<!-- Boutons d'action -->
					<SolidColorBrush x:Key="AppLiveBg"      Color="#d0f5e8"/>
					<SolidColorBrush x:Key="AppLiveBorder"  Color="#6ee7b7"/>
					<SolidColorBrush x:Key="AppStopBg"      Color="#fce8e8"/>
					<SolidColorBrush x:Key="AppStopBorder"  Color="#f0a0a0"/>
					<SolidColorBrush x:Key="AppRecBg"       Color="#fce8e8"/>
					<SolidColorBrush x:Key="AppRecBorder"   Color="#f0a0a0"/>
				</ResourceDictionary>

			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />

		<!-- Centrage vertical par défaut du contenu des boutons -->
		<Style Selector=":is(Button)">
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<!-- Apparence commune de tous les flyouts/popups -->
		<Style Selector="FlyoutPresenter">
			<Setter Property="Background" Value="{DynamicResource AppSurface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12"/>
		</Style>

		<!-- ═══ STYLES DE BOUTONS D'ACTION FACTORISÉS ═══ -->
		<Style Selector="Button.ctrl-btn">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,6"/>
			
		</Style>
		<Style Selector="Button.ctrl-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
		</Style>

		<Style Selector="Button.dlg-btn">
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="14,8"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		
		<!-- ═══ STYLES DE MENUS ET TOOLBARS GLOBAUX ═══ -->
		<Style Selector="Button.scene-menu-item">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="10,7"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.scene-menu-item:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
		</Style>

		<Style Selector="Button.scene-toolbar-item, ToggleButton.scene-toolbar-item">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.scene-toolbar-item:pointerover /template/ ContentPresenter, ToggleButton.scene-toolbar-item:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
		</Style>

		<Style Selector="ToggleButton.scene-toolbar-item:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
		</Style>

		<Style Selector="ToggleButton.scene-toolbar-item:checked">
			<Setter Property="Foreground" Value="#5b8def"/>
		</Style>

		<Style Selector="Button.scene-toolbar-item.danger, Button.scene-menu-item.danger">
			<Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
		</Style>

		<!-- ═══ STYLES IA GLOBAUX ═══ -->
		<Style Selector="Button.ai-mode">
			<Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg4}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,7"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.ai-mode:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppBadgeBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
		</Style>

		<Style Selector="Button.ai-active">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
			<Setter Property="Foreground" Value="#5b8def"/>
			<Setter Property="BorderBrush" Value="#5b8def"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,7"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<!-- ═══ NAVIGATION PRINCIPALE ═══ -->
		<Style Selector="Button.nav">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="20,0"/>
			<Setter Property="Height" Value="46"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button.nav:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
		</Style>

		<!-- ═══ BOUTONS DE DIALOGUES GLOBAUX ═══ -->
		<Style Selector="Button.dlg-btn">
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<!-- ═══ STYLES PARAMÈTRES / SETTINGS ═══ -->
		<Style Selector="Button.settings-nav">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="18,10"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.settings-nav:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
		</Style>

		<Style Selector="TextBlock.setting-label">
			<Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.section-title">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource AppFg4}"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<Style Selector="Button.platform-connect">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="14,7"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.platform-connect:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppAccentBg2}"/>
		</Style>
	</Application.Styles>
</Application>