<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Re-skins Dock.Avalonia.Themes.Fluent's default tokens with Castor's own palette
         (Styles/Colors.axaml) so docked panes read as part of the app, not a foreign
         VS-Code-style theme. Values are duplicated from Colors.axaml rather than aliased,
         because StaticResource can't reach into another file's ThemeDictionaries - it
         resolves eagerly against this dictionary's own scope, so an alias to "AppSurface"
         fails at startup even though the same lookup works fine via DynamicResource. -->
    <Styles.Resources>
        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#151925"/>
                    <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#2d3347"/>
                    <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#e7e9f0"/>
                    <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#1b2030"/>
                    <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#5b7cf5"/>

                    <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#0a0c12"/>
                    <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#151925"/>
                    <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#07090e"/>
                    <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#151925"/>
                    <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#151925"/>
                    <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#151925"/>

                    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#2d3347"/>
                    <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#363d54"/>
                    <SolidColorBrush x:Key="DockSeparatorBrush" Color="#2d3347"/>
                    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#2d3347"/>
                    <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#363d54"/>
                    <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#5b7cf5"/>

                    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#1b2030"/>
                    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#16224a"/>
                    <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#5b7cf5"/>
                    <SolidColorBrush x:Key="DockTabForegroundBrush" Color="#b4bacb"/>
                    <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#e7e9f0"/>
                    <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#e7e9f0"/>
                    <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="#363d54"/>
                    <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#e7e9f0"/>
                    <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="#e7e9f0"/>
                    <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#e7e9f0"/>
                    <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="#e7e9f0"/>

                    <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#5b7cf5"/>

                    <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="#1b2030"/>
                    <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="#363d54"/>
                    <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="#F87171"/>
                    <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="#b4bacb"/>
                    <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="#b4bacb"/>

                    <!-- Vector replacements for the stock drag-target PNG glyphs: a rounded
                         square (AppSurface2 fill, AppBorder stroke) with an accent bar on
                         the edge the drop would dock to. 40x40 canvas to match
                         DockTargetSelectorSize. Per-variant so they follow the theme. -->
                    <DrawingImage x:Key="CastorDockTargetTop">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#1b2030"><GeometryDrawing.Pen><Pen Brush="#2d3347" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#5b7cf5"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,6,28,9" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetBottom">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#1b2030"><GeometryDrawing.Pen><Pen Brush="#2d3347" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#5b7cf5"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,25,28,9" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetLeft">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#1b2030"><GeometryDrawing.Pen><Pen Brush="#2d3347" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#5b7cf5"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,6,9,28" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetRight">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#1b2030"><GeometryDrawing.Pen><Pen Brush="#2d3347" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#5b7cf5"><GeometryDrawing.Geometry><RectangleGeometry Rect="25,6,9,28" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetCenter">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#1b2030"><GeometryDrawing.Pen><Pen Brush="#2d3347" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#5b7cf5"><GeometryDrawing.Geometry><RectangleGeometry Rect="9,9,22,22" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#cfd4e3"/>
                    <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#141824"/>
                    <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#eef0f6"/>
                    <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#2f5de0"/>

                    <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#f6f7fb"/>
                    <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#d9dde9"/>
                    <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#ffffff"/>

                    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#cfd4e3"/>
                    <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#c3c9db"/>
                    <SolidColorBrush x:Key="DockSeparatorBrush" Color="#cfd4e3"/>
                    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#cfd4e3"/>
                    <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#c3c9db"/>
                    <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#2f5de0"/>

                    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#e6e9f2"/>
                    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#dbe6ff"/>
                    <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#2f5de0"/>
                    <SolidColorBrush x:Key="DockTabForegroundBrush" Color="#394057"/>
                    <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#141824"/>
                    <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#141824"/>
                    <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="#c3c9db"/>
                    <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#141824"/>
                    <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="#141824"/>
                    <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#141824"/>
                    <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="#141824"/>

                    <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#2f5de0"/>

                    <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="#e6e9f2"/>
                    <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="#c3c9db"/>
                    <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="#b3201a"/>
                    <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="#394057"/>
                    <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="#394057"/>

                    <!-- Light-variant twins of the drop-target glyphs (AppSurface2 #eef0f6,
                         AppBorder #cfd4e3, accent #2f5de0). -->
                    <DrawingImage x:Key="CastorDockTargetTop">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#eef0f6"><GeometryDrawing.Pen><Pen Brush="#cfd4e3" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#2f5de0"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,6,28,9" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetBottom">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#eef0f6"><GeometryDrawing.Pen><Pen Brush="#cfd4e3" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#2f5de0"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,25,28,9" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetLeft">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#eef0f6"><GeometryDrawing.Pen><Pen Brush="#cfd4e3" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#2f5de0"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,6,9,28" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetRight">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#eef0f6"><GeometryDrawing.Pen><Pen Brush="#cfd4e3" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#2f5de0"><GeometryDrawing.Geometry><RectangleGeometry Rect="25,6,9,28" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                    <DrawingImage x:Key="CastorDockTargetCenter">
                        <DrawingGroup>
                            <GeometryDrawing Brush="#eef0f6"><GeometryDrawing.Pen><Pen Brush="#cfd4e3" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,38,38" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                            <GeometryDrawing Brush="#2f5de0"><GeometryDrawing.Geometry><RectangleGeometry Rect="9,9,22,22" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Styles.Resources>

    <!-- Both drag-target selectors (DockTarget for per-dock zones, GlobalDockTarget for
         window edges) show fixed light PNG glyphs (DockAnchorableTop.png etc.) that
         can't be recolored. Swap each Image's Source for the themed DrawingImage above.
         The theme assigns the PNG through a name-level rule (Image#PART_TopSelector), so
         these equal-specificity, later-declared rules replace it while leaving the
         theme's own show/hide logic (:vertical / :horizontal) untouched. -->
    <Style Selector="DockTarget /template/ Image#PART_TopSelector, GlobalDockTarget /template/ Image#PART_TopSelector">
        <Setter Property="Source" Value="{DynamicResource CastorDockTargetTop}"/>
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_BottomSelector, GlobalDockTarget /template/ Image#PART_BottomSelector">
        <Setter Property="Source" Value="{DynamicResource CastorDockTargetBottom}"/>
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_LeftSelector, GlobalDockTarget /template/ Image#PART_LeftSelector">
        <Setter Property="Source" Value="{DynamicResource CastorDockTargetLeft}"/>
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_RightSelector, GlobalDockTarget /template/ Image#PART_RightSelector">
        <Setter Property="Source" Value="{DynamicResource CastorDockTargetRight}"/>
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_CenterSelector, GlobalDockTarget /template/ Image#PART_CenterSelector">
        <Setter Property="Source" Value="{DynamicResource CastorDockTargetCenter}"/>
    </Style>

    <!-- One rounded card per pane. Tool panes: the title/icons bar (ToolChromeControl's
         header) rounds its top corners and each pane's own root Border rounds the bottom
         ones (see the pane views - CornerRadius on the dock's DeferredContentPresenter
         didn't reliably render); nothing rounds at the seam, so bar + content read as a
         single block. -->
    <Style Selector="ToolChromeControl /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="6,6,0,0"/>
    </Style>

    <!-- Dock draws two extra strokes around tool pane content that poke past those
         rounded corners. ToolControl wraps the content with its own 1px side border,
         doubling the pane Border's outline; and ToolTabStrip, docked at the bottom,
         draws a 1px top line in its two fill borders (with a single tool it hides its
         tabs via :singleitem, so that line was all that remained of it). Zero both -
         the strip itself stays, so tabs still show if two tools get grouped in one dock. -->
    <Style Selector="ToolControl /template/ Border#PART_Border">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ToolTabStrip /template/ Border#PART_BorderLeftFill, ToolTabStrip /template/ Border#PART_BorderRightFill">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- "Afficher le nom des docks" setting: CastorDockShowTitles lives in App.axaml's
         resources and is rewritten at runtime by AvaloniaDockChromeService, so this
         DynamicResource re-evaluates live. The pin/menu icons stay so the bar remains
         a drag handle; only the title text goes. A detached panel is left out of this:
         its chrome bar replaces the window title bar, so hiding the text there would
         leave the floating window unnamed. -->
    <Style Selector="ToolChromeControl:not(:floating) /template/ TextBlock#PART_Title">
        <Setter Property="IsVisible" Value="{DynamicResource CastorDockShowTitles}"/>
    </Style>

    <!-- ToolChromeControl draws a 1px divider strip between the header and the content
         (PART_Panel, filled with the border color) - visible as a stray seam line cutting
         the rounded card in two. Hide it so the bar and content read as one block. -->
    <Style Selector="ToolChromeControl /template/ Panel#PART_Panel">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- The pin/menu/close/maximize buttons inherit FluentTheme's default rounded Button
         corners, which shows up as a stray rounded pill floating inside the header instead
         of a flush toolbar icon. Flatten them so only the bar's own outer corners round. -->
    <Style Selector="ToolChromeControl /template/ Button">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- UniformToFill can crop/distort the stock chrome icon glyphs (pin, close, ...);
         Uniform keeps them legible until they're replaced with the app's own icon set. -->
    <Style Selector="ToolChromeControl /template/ Path">
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- A detached preview filling its screen (StudioHostWindow): the bare picture, with neither
         the panel bar nor the card's rounded border. -->
    <Style Selector="HostWindow.fullscreen ToolChromeControl /template/ Border#PART_Border">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="HostWindow.fullscreen Border.preview-card">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</Styles>
