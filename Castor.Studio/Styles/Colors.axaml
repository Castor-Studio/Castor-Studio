<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Contrastes WCAG 2.x (luminance relative). Seuils : 4.5:1 pour un texte, 3:1 pour une
         icône ou un contour porteur de sens. Chaque couleur de premier plan est mesurée sur
         son fond réel. Castor.Studio.Tests/ColorContrastTests.cs refait la mesure : changer
         une valeur ici sans tenir les seuils fait échouer les tests. -->

    <!-- Texte posé sur l'image vidéo (aperçus, tuiles multicam) : le fond est noir dans les
         deux thèmes, donc ces deux-là ne suivent pas le thème. -->
    <SolidColorBrush x:Key="VideoFgBrush" Color="#c9cddb"/>
    <SolidColorBrush x:Key="VideoFgMutedBrush" Color="#a3a9bd"/>
    <SolidColorBrush x:Key="VideoErrorBrush" Color="#F87171"/>

    <!-- Les deux grands boutons du Studio : mêmes aplats dans les deux thèmes. -->
    <SolidColorBrush x:Key="AppGoLiveFill" Color="#0b6b46"/>
    <SolidColorBrush x:Key="AppGoLiveBorder" Color="#8fd3b5"/>
    <SolidColorBrush x:Key="AppGoLiveFg" Color="#e3f6ed"/>
    <SolidColorBrush x:Key="AppRecFill" Color="#b3201a"/>
    <SolidColorBrush x:Key="AppRecFillBorder" Color="#e8a9a5"/>
    <SolidColorBrush x:Key="AppRecFillFg" Color="#fdeceb"/>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Fonds sur lesquels se pose du texte, du plus sombre au plus clair. -->
            <SolidColorBrush x:Key="AppVeryDarkBg" Color="#07090e"/>
            <SolidColorBrush x:Key="AppBg" Color="#0a0c12"/>
            <SolidColorBrush x:Key="AppSidebarBg" Color="#0b0d13"/>
            <SolidColorBrush x:Key="AppPanelBg" Color="#0e1017"/>
            <SolidColorBrush x:Key="AppSurface3" Color="#0f1119"/>
            <SolidColorBrush x:Key="AppChromeBg" Color="#101320"/>
            <SolidColorBrush x:Key="AppSurface" Color="#151925"/>
            <SolidColorBrush x:Key="AppNavHoverBg" Color="#171a26"/>
            <SolidColorBrush x:Key="AppBadgeBg" Color="#171a26"/>
            <SolidColorBrush x:Key="AppSurface2" Color="#1b2030"/>
            <SolidColorBrush x:Key="AppAccentBg2" Color="#14203d"/>
            <SolidColorBrush x:Key="AppAccentBg" Color="#16224a"/>
            <SolidColorBrush x:Key="AppNavBadgeBg" Color="#242a3b"/>
            <!-- Sous un écran vide d'aperçu : noir comme l'image qu'il remplace. -->
            <SolidColorBrush x:Key="AppPreviewEmptyBg" Color="#000000"/>


            <!-- Échelle de texte. AppFg6 rejoint AppFg5 : en dessous, un texte n'est plus lisible. -->
            <SolidColorBrush x:Key="AppFg1" Color="#e7e9f0"/>
            <SolidColorBrush x:Key="AppFg2" Color="#c9cddb"/>
            <SolidColorBrush x:Key="AppFg3" Color="#c2c7d6"/>
            <SolidColorBrush x:Key="AppFg4" Color="#b4bacb"/>
            <SolidColorBrush x:Key="AppFg5" Color="#a3a9bd"/>
            <SolidColorBrush x:Key="AppFg6" Color="#a3a9bd"/>

            <!-- AppAccentFg pour un texte ou une icône, AppAccentFill pour un aplat ou un trait. -->
            <SolidColorBrush x:Key="AppAccentFg" Color="#8fabff"/>
            <SolidColorBrush x:Key="AppAccentFill" Color="#5b7cf5"/>
            <SolidColorBrush x:Key="AppOnAccentFg" Color="#0a0c12"/>
            <!-- Case cochée et curseur : le rouge de la marque, pas l'accent de Windows. -->
            <SolidColorBrush x:Key="AppBrandRed" Color="#e5231b"/>
            <!-- Bouton Enregistrer des Paramètres : teinté en sombre, plein en clair. -->
            <SolidColorBrush x:Key="AppSaveBg" Color="#16224a"/>
            <SolidColorBrush x:Key="AppSaveFg" Color="#8fabff"/>

            <!-- Contours et séparateurs décoratifs ; AppBorderStrong entoure un champ. -->
            <SolidColorBrush x:Key="AppBorder" Color="#2d3347"/>
            <SolidColorBrush x:Key="AppBorder2" Color="#363d54"/>
            <SolidColorBrush x:Key="AppBorderStrong" Color="#6b7392"/>

            <!-- États. Mesurés sur leur fond réel, pas sur AppBg. -->
            <SolidColorBrush x:Key="StatusOkBrush" Color="#2ecc8f"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#FBBF24"/>
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171"/>
            <SolidColorBrush x:Key="StatusRecBrush" Color="#F87171"/>
            <!-- Texte posé sur un aplat d'état (DÉMARRER, badge LIVE, suppression). -->
            <SolidColorBrush x:Key="AppOnStatusFg" Color="#07090e"/>

            <!-- « Prête » : teinté en sombre, plein en clair. Le panneau Scène active n'a de pastille qu'en clair. -->
            <SolidColorBrush x:Key="AppChipBg" Color="#0f2a22"/>
            <SolidColorBrush x:Key="AppChipBorder" Color="#1c4a3a"/>
            <SolidColorBrush x:Key="AppChipFg" Color="#3ddc9a"/>
            <SolidColorBrush x:Key="AppReadyFg" Color="#2ecc8f"/>
            <SolidColorBrush x:Key="AppReadyPillBg" Color="Transparent"/>
            <SolidColorBrush x:Key="AppReadyPillBorder" Color="Transparent"/>

            <SolidColorBrush x:Key="AppLiveBg" Color="#0f2a22"/>
            <SolidColorBrush x:Key="AppLiveBorder" Color="#1c4a3a"/>
            <SolidColorBrush x:Key="AppStopBg" Color="#251218"/>
            <SolidColorBrush x:Key="AppStopBorder" Color="#2f1820"/>
            <SolidColorBrush x:Key="AppRecBg" Color="#2d1212"/>
            <SolidColorBrush x:Key="AppRecBorder" Color="#3d1a1a"/>
            <SolidColorBrush x:Key="AppPauseBg" Color="#2a2110"/>
            <SolidColorBrush x:Key="AppPauseBorder" Color="#3a2e14"/>
            <SolidColorBrush x:Key="AppErrorBg" Color="#3b1219"/>
            <SolidColorBrush x:Key="AppErrorBorder" Color="#7f1d1d"/>

            <!-- Fluent lit ces clés pour ses cases et ses curseurs. -->
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5b7cf5"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#101320"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#e5231b"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#e5231b"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#e5231b"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#e5231b"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#e5231b"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#e5231b"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#e5231b"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#e5231b"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#e5231b"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#e5231b"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#e5231b"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#e5231b"/>

            <!-- La trame de points sous le canvas de composition (Scènes). -->
            <DrawingBrush x:Key="AppCanvasDots" TileMode="Tile" Stretch="None" DestinationRect="0,0,20,20">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#363d54">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="10,10" RadiusX="1" RadiusY="1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <!-- Fonds sur lesquels se pose du texte, du plus clair au plus sombre. -->
            <SolidColorBrush x:Key="AppSurface" Color="#ffffff"/>
            <SolidColorBrush x:Key="AppChromeBg" Color="#ffffff"/>
            <SolidColorBrush x:Key="AppSurface3" Color="#fafbfd"/>
            <SolidColorBrush x:Key="AppPanelBg" Color="#f1f3f9"/>
            <SolidColorBrush x:Key="AppBg" Color="#f6f7fb"/>
            <SolidColorBrush x:Key="AppSidebarBg" Color="#eef0f6"/>
            <SolidColorBrush x:Key="AppAccentBg2" Color="#e6eeff"/>
            <SolidColorBrush x:Key="AppSurface2" Color="#eef0f6"/>
            <SolidColorBrush x:Key="AppNavHoverBg" Color="#e6e9f2"/>
            <SolidColorBrush x:Key="AppBadgeBg" Color="#e6e9f2"/>
            <SolidColorBrush x:Key="AppPreviewEmptyBg" Color="#e6e9f2"/>
            <SolidColorBrush x:Key="AppAccentBg" Color="#dbe6ff"/>
            <SolidColorBrush x:Key="AppNavBadgeBg" Color="#d9dde9"/>
            <SolidColorBrush x:Key="AppVeryDarkBg" Color="#d9dde9"/>


            <SolidColorBrush x:Key="AppFg1" Color="#141824"/>
            <SolidColorBrush x:Key="AppFg2" Color="#2a3040"/>
            <SolidColorBrush x:Key="AppFg3" Color="#2a3040"/>
            <SolidColorBrush x:Key="AppFg4" Color="#394057"/>
            <SolidColorBrush x:Key="AppFg5" Color="#4a5168"/>
            <SolidColorBrush x:Key="AppFg6" Color="#4a5168"/>

            <SolidColorBrush x:Key="AppAccentFg" Color="#1d4ed8"/>
            <SolidColorBrush x:Key="AppAccentFill" Color="#2f5de0"/>
            <SolidColorBrush x:Key="AppOnAccentFg" Color="#ffffff"/>
            <SolidColorBrush x:Key="AppBrandRed" Color="#b3201a"/>
            <SolidColorBrush x:Key="AppSaveBg" Color="#2f5de0"/>
            <SolidColorBrush x:Key="AppSaveFg" Color="#ffffff"/>

            <SolidColorBrush x:Key="AppBorder" Color="#cfd4e3"/>
            <SolidColorBrush x:Key="AppBorder2" Color="#c3c9db"/>
            <SolidColorBrush x:Key="AppBorderStrong" Color="#6b7392"/>

            <!-- Les teintes vives du thème sombre tombent sous 3.5:1 sur fond clair : on passe
                 aux nuances foncées de la même famille. -->
            <SolidColorBrush x:Key="StatusOkBrush" Color="#0b6b46"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#92400e"/>
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#b3201a"/>
            <SolidColorBrush x:Key="StatusRecBrush" Color="#b3201a"/>
            <SolidColorBrush x:Key="AppOnStatusFg" Color="#ffffff"/>

            <SolidColorBrush x:Key="AppChipBg" Color="#0b6b46"/>
            <SolidColorBrush x:Key="AppChipBorder" Color="#8fd3b5"/>
            <SolidColorBrush x:Key="AppChipFg" Color="#e3f6ed"/>
            <SolidColorBrush x:Key="AppReadyFg" Color="#e3f6ed"/>
            <SolidColorBrush x:Key="AppReadyPillBg" Color="#0b6b46"/>
            <SolidColorBrush x:Key="AppReadyPillBorder" Color="#8fd3b5"/>

            <SolidColorBrush x:Key="AppLiveBg" Color="#d6f3e6"/>
            <SolidColorBrush x:Key="AppLiveBorder" Color="#8fd3b5"/>
            <SolidColorBrush x:Key="AppStopBg" Color="#fce8e8"/>
            <SolidColorBrush x:Key="AppStopBorder" Color="#e8a9a5"/>
            <SolidColorBrush x:Key="AppRecBg" Color="#fce8e8"/>
            <SolidColorBrush x:Key="AppRecBorder" Color="#e8a9a5"/>
            <SolidColorBrush x:Key="AppPauseBg" Color="#fdf3dc"/>
            <SolidColorBrush x:Key="AppPauseBorder" Color="#f2c46d"/>
            <SolidColorBrush x:Key="AppErrorBg" Color="#fde8e8"/>
            <SolidColorBrush x:Key="AppErrorBorder" Color="#e8a9a5"/>

            <!-- Fluent lit ces clés pour ses cases et ses curseurs. -->
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2f5de0"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#ffffff"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#b3201a"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#b3201a"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#b3201a"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#b3201a"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#b3201a"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#b3201a"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#b3201a"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#b3201a"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#b3201a"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#b3201a"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#b3201a"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#b3201a"/>

            <!-- La trame de points sous le canvas de composition (Scènes). -->
            <DrawingBrush x:Key="AppCanvasDots" TileMode="Tile" Stretch="None" DestinationRect="0,0,20,20">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#c3c9db">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="10,10" RadiusX="1" RadiusY="1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
