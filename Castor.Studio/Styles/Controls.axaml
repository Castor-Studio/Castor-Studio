<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CastorApplication.Controls">
    <Style Selector=":is(Button)">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- The app's fields: same height, same outline, everywhere. -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource AppChromeBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
    </Style>
    <!-- Main action of an empty screen. -->
    <Style Selector="Button.primary">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource AppAccentFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentFg}"/>
        <Setter Property="Opacity" Value="0.88"/>
    </Style>
    <!-- Add: a scene, a source. -->
    <Style Selector="Button.add">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.add:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg2}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
    </Style>
    <!-- Button with a discreet outline (canvas bar). -->
    <Style Selector="Button.outline">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Toolbar of the selected source. -->
    <Style Selector="Button.tool, ToggleButton.tool">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tool Path, ToggleButton.tool Path">
        <Setter Property="Stroke" Value="{DynamicResource AppFg2}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Save, at the foot of Settings. -->
    <Style Selector="Button.save">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="38,0"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AppSaveBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppSaveFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.save:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSaveBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppSaveFg}"/>
        <Setter Property="Opacity" Value="0.88"/>
    </Style>
    <Style Selector="Button.save:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSaveBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppSaveFg}"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <!-- MessageBar (Controls/MessageBar.cs): every status and error line of the app. Neutral
         for a confirmation, red for an error; the text is a live region, so a screen reader
         reads it when it appears without moving focus (at once for an error). The ✕ is 24 × 24
         to stay an easy target next to small text, and named, since the glyph alone reads as
         "multiplication"; it sits on the first line of a wrapped message. -->
    <Style Selector="controls|MessageBar">
        <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Name="PART_Text" Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button Name="PART_Dismiss" Grid.Column="1"
                                Command="{TemplateBinding DismissCommand}"
                                Content="✕" FontSize="10"
                                Foreground="{TemplateBinding Foreground}"
                                Background="Transparent" BorderThickness="0"
                                MinWidth="24" MinHeight="24" Padding="0" CornerRadius="4"
                                Margin="6,-5,-6,-5" VerticalAlignment="Top"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Cursor="Hand" IsVisible="False"
                                ToolTip.Tip="Masquer le message"
                                AutomationProperties.Name="Masquer le message"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|MessageBar:dismissable /template/ Button#PART_Dismiss">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="controls|MessageBar /template/ Button#PART_Dismiss:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface3}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
    </Style>
    <Style Selector="controls|MessageBar:error">
        <Setter Property="Background" Value="{DynamicResource AppErrorBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
    </Style>
    <Style Selector="controls|MessageBar:error /template/ TextBlock#PART_Text">
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
    </Style>
    <Style Selector="controls|MessageBar:error /template/ Button#PART_Dismiss:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppErrorBorder}"/>
    </Style>
    <Style Selector="Button.ctrl-btn">
        <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Button.ctrl-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
    </Style>
    <Style Selector="Button.scene-menu-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.scene-menu-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
    </Style>
    <Style Selector="Button.scene-toolbar-item, ToggleButton.scene-toolbar-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.scene-toolbar-item:pointerover /template/ ContentPresenter, ToggleButton.scene-toolbar-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
    </Style>
    <Style Selector="ToggleButton.scene-toolbar-item:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
    </Style>
    <Style Selector="ToggleButton.scene-toolbar-item:checked">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
    </Style>
    <Style Selector="Button.scene-toolbar-item.danger, Button.scene-menu-item.danger">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
    </Style>
    <!-- Exclusive choice among a few options (AI mode, multicam layout):
         a groove, the chosen option raised in it. RadioButtons rather than
         pairs of shown / hidden buttons, so the group reads as one choice,
         by keyboard and by screen reader. The already chosen option no longer reacts:
         clicking it again would rerun its command (restart an AI session, for example). -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource AppChromeBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="RadioButton.segment">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <Border Name="PART_FocusRing" BorderBrush="{DynamicResource AppAccentFill}"
                            BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"
                            IsVisible="False"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="RadioButton.segment:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="RadioButton.segment:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Selecting a scene for the AI, on multicam tiles. A pill rather than
         a checkbox: it carries its own label, so its use is clear
         without hovering, and it reads at the same distance as the other pills. -->
    <Style Selector="ToggleButton.ai-pick">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.ai-pick:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppBadgeBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
    </Style>
    <Style Selector="ToggleButton.ai-pick:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentFill}"/>
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.5"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
    </Style>

    <!-- Top bar gear (MainWindow): opens Settings, accent-tinted while Settings is open. -->
    <Style Selector="Button.settings-gear">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.settings-gear Path">
        <Setter Property="Stroke" Value="{DynamicResource AppFg3}"/>
    </Style>
    <Style Selector="Button.settings-gear:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
    </Style>
    <Style Selector="Button.settings-gear:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource AppFg1}"/>
    </Style>
    <Style Selector="Button.settings-gear.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
    </Style>
    <Style Selector="Button.settings-gear.active Path">
        <Setter Property="Stroke" Value="{DynamicResource AppAccentFg}"/>
    </Style>
    <Style Selector="Button.dlg-btn">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Settings navigation: normal, hover, open, open and hovered. The accent bar
         on the left exists in every state (transparent when unselected) so that
         the label does not move when the section opens. -->
    <Style Selector="RadioButton.settings-nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <!-- Keyboard focus marker, distinct from hover. -->
                    <Border Name="PART_FocusRing" BorderBrush="{DynamicResource AppAccentFill}"
                            BorderThickness="1" IsVisible="False"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.settings-nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg2}"/>
    </Style>
    <Style Selector="RadioButton.settings-nav:checked">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.settings-nav:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
    </Style>
    <Style Selector="RadioButton.settings-nav:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="TextBlock.setting-label">
        <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.5"/>
        <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style Selector="Button.platform-connect">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.platform-connect:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBg2}"/>
    </Style>

    <!-- Session state (top bar, Status and Active scene panels): off by default,
         red on air (live class), green when everything is ready (ready class). Styles
         rather than colors computed in ViewModels, to follow the theme. -->
    <Style Selector="TextBlock.session-state">
        <Setter Property="Foreground" Value="{DynamicResource AppFg4}"/>
    </Style>
    <Style Selector="TextBlock.session-state.ready">
        <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}"/>
    </Style>
    <Style Selector="TextBlock.session-state.live">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
    </Style>
    <Style Selector="Ellipse.session-state">
        <Setter Property="Fill" Value="{DynamicResource AppFg4}"/>
    </Style>
    <Style Selector="Ellipse.session-state.ready">
        <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/>
    </Style>
    <Style Selector="Ellipse.session-state.live">
        <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}"/>
    </Style>
    <!-- Paused recording: amber rather than red, nothing is being written. Declared after
         live so it wins when both classes are set. -->
    <Style Selector="TextBlock.session-state.paused">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}"/>
    </Style>
    <Style Selector="Ellipse.session-state.paused">
        <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}"/>
    </Style>
</Styles>
