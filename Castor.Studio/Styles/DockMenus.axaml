<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:CompileBindings="False">

    <!-- Dock reads both menus through a DynamicResource, so redeclaring their keys here replaces
         them. What they gain is "Rattacher", which sends a detached panel back to its place.

         What they lose is everything a fixed four-panel workspace cannot act on, and two ways to
         make a panel seem to vanish: "Dock as Tabbed Document" buries a panel in a tab strip, and auto-hide collapses it into a strip on a window edge.
         Panels cannot be closed either, so no menu offers to.

         Bindings are resolved at runtime: "Rattacher" hangs off a command declared by
         StudioDockFactory, which the Factory property only exposes as IFactory. -->

    <!-- Tool panels: the bar's arrow button, and a right-click on the bar. -->
    <MenuFlyout x:Key="ToolChromeControlContextMenu">
        <MenuItem Header="{DynamicResource ToolChromeControlFloatString}"
                  Command="{Binding Owner.Factory.FloatDockable}"
                  CommandParameter="{Binding ActiveDockable}"
                  IsVisible="{Binding $parent[ToolChromeControl].IsFloating, Converter={x:Static BoolConverters.Not}}"/>
        <MenuItem Header="{DynamicResource CastorDockReturnHomeString}"
                  Command="{Binding Owner.Factory.ReturnHomeCommand}"
                  CommandParameter="{Binding}"
                  IsVisible="{Binding $parent[ToolChromeControl].IsFloating}"/>
        <!-- Only a detached preview can go fullscreen (StudioDockFactory.Fullscreen): the entry
             shows where the command accepts the dock, and nowhere else. -->
        <MenuItem Header="{DynamicResource CastorPreviewFullscreenString}"
                  InputGesture="F11"
                  Command="{Binding Owner.Factory.TogglePreviewFullscreenCommand}"
                  CommandParameter="{Binding}"
                  IsVisible="{Binding $self.IsEffectivelyEnabled}"/>
    </MenuFlyout>

</ResourceDictionary>
