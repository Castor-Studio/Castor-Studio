<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Scenes"
             x:Class="CastorApplication.Controls.SceneCompositionCanvas"
             x:DataType="vm:SceneCompositionViewModel">
    <Panel Background="Black">

        <!-- Le Viewbox met le canvas du moteur à l'échelle du panneau d'un seul coup. Les
             calques gardent ainsi les coordonnées du moteur, telles qu'elles ont été lues :
             aucune position, aucune taille n'est convertie calque par calque. -->
        <Viewbox Stretch="Uniform" Margin="14">
            <!-- Le cadre est posé par-dessus, pas autour : une bordure autour décalerait
                 l'origine du canvas de son épaisseur, et les sources avec elle. -->
            <Panel Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                   Background="#05050A" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Layers}">

                    <!-- Un Canvas superpose les calques dans l'ordre de la liste : celle-ci
                         va de l'arrière-plan vers le premier plan, donc le dernier ajouté
                         couvre les précédents, comme dans le rendu du moteur. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.Styles>
                        <Style Selector="ItemsControl > ContentPresenter"
                               x:DataType="vm:CompositionLayerViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.Styles>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompositionLayerViewModel">
                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                    BorderBrush="{Binding Color}" BorderThickness="4"
                                    CornerRadius="6" ClipToBounds="True">
                                <Panel>
                                    <!-- Un aplat translucide : deux sources qui se
                                         chevauchent restent lisibles l'une sous l'autre. -->
                                    <Rectangle Fill="{Binding Color}" Opacity="0.18"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="12" Padding="14,8" CornerRadius="6"
                                            Background="#CC0B0B12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="34" FontWeight="SemiBold"
                                                       Foreground="#F2F2F7"/>
                                            <TextBlock Text="{Binding Geometry}"
                                                       FontSize="26" Foreground="#9A9AB0"/>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Stroke="{DynamicResource AppBorder2}" StrokeThickness="4"
                           IsHitTestVisible="False"/>
            </Panel>
        </Viewbox>

        <StackPanel IsVisible="{Binding !HasLayers}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="COMPOSITION"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppFg5}"
                       FontSize="13" FontWeight="Bold" LetterSpacing="2"/>
            <TextBlock Text="{Binding Placeholder}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppFg4}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380"/>
        </StackPanel>

        <TextBlock Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"
                   Foreground="{StaticResource StatusErrorBrush}"
                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>
    </Panel>
</UserControl>
