<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CastorApplication.Controls"
             xmlns:scenes="using:CastorApplication.ViewModels.Scenes"
             x:Class="CastorApplication.Controls.StudioPreview"
             x:Name="PreviewRoot"
             x:DataType="controls:StudioPreview"
             Focusable="True">
    <UserControl.Styles>
        <!-- Les outils ne prennent jamais le clavier : il reste à l'aperçu, où les raccourcis
             s'écoutent. -->
        <Style Selector="Button.composition-tool">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg3}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.composition-tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurface2}"/>
        </Style>
        <Style Selector="Button.composition-tool.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBg}"/>
        </Style>
        <Style Selector="Button.composition-tool.active">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
        </Style>
        <!-- Sans source choisie, la barre s'efface d'un bloc, icônes comprises. -->
        <Style Selector="Button.composition-tool:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.composition-tool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Les icônes du menu de la source, au même trait. -->
        <Style Selector="Button.composition-tool Path.tool-icon">
            <Setter Property="Stroke" Value="{DynamicResource AppFg4}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.composition-tool:pointerover Path.tool-icon">
            <Setter Property="Stroke" Value="{DynamicResource AppFg2}"/>
        </Style>
        <Style Selector="Button.composition-tool:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppFg1}"/>
        </Style>
        <Style Selector="Button.composition-tool.active Path.tool-icon">
            <Setter Property="Stroke" Value="{DynamicResource AppAccentFg}"/>
        </Style>
        <Style Selector="Rectangle.composition-tool-separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Fill" Value="{DynamicResource AppBorder}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*, Auto">
    <!-- Le pointeur ne peut pas atterrir sur la surface native : elle se déclare
         transparente aux tests de survol, et l'hôte ne teste pas le survol. Il tombe donc
         ici, sur le fond, qui le ramène dans le repère du canvas. -->
    <Panel x:Name="Picture"
           Grid.Row="0"
           Background="Black"
           PointerPressed="OnPicturePointerPressed"
           PointerMoved="OnPicturePointerMoved"
           PointerReleased="OnPicturePointerReleased"
           PointerCaptureLost="OnPicturePointerCaptureLost"
           PointerWheelChanged="OnPicturePointerWheelChanged"
           PointerExited="OnPicturePointerExited">
        <controls:ObsPreviewHost x:Name="NativePreview"
                                 IsHitTestVisible="False"
                                 Scene="{Binding #PreviewRoot.Scene}"
                                 Runtime="{Binding #PreviewRoot.PreviewRuntime}"
                                 Composition="{Binding #PreviewRoot.Composition}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

        <StackPanel IsVisible="{Binding #NativePreview.ShowPlaceholder}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="APERÇU"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VideoFgBrush}"
                       FontSize="13" FontWeight="Bold" LetterSpacing="2"/>
            <TextBlock Text="{Binding #PreviewRoot.Message}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VideoFgMutedBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" />
            <TextBlock Text="{Binding #NativePreview.ErrorMessage}"
                       IsVisible="{Binding #NativePreview.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VideoErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" />
        </StackPanel>
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="12" Padding="10,6" CornerRadius="5"
                IsVisible="{Binding #PreviewRoot.ShowSceneName}"
                Background="#AA0B0B12" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <TextBlock Text="{Binding #PreviewRoot.Scene.Name}"
                       Foreground="{DynamicResource VideoFgBrush}" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Ce que le geste en cours écrit, près du pointeur. Une fenêtre à elle, et non une
             couche de la page : c'est ce qui la laisse passer au-dessus de la surface native. -->
        <Popup x:Name="Readout"
               PlacementTarget="{Binding #Picture}"
               Placement="AnchorAndGravity"
               PlacementAnchor="TopLeft"
               PlacementGravity="BottomRight"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="False"
               IsLightDismissEnabled="False"
               IsHitTestVisible="False">
            <Border Padding="8,4" CornerRadius="5"
                    Background="{DynamicResource AppNavBadgeBg}"
                    BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
                <TextBlock x:Name="ReadoutText"
                           Foreground="{DynamicResource AppFg1}"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Popup>
    </Panel>

    <!-- La barre du canvas : les commandes de la source choisie, à portée de souris. Sous
         l'image et non dessus — rien ne se pose sur la surface native. Chaque bouton passe
         par le même chemin que son raccourci, et sa bulle le donne. Seul un aperçu qui
         compose (la page Scènes) en a une. -->
    <Border x:Name="Toolbar"
            Grid.Row="1"
            IsVisible="{Binding #PreviewRoot.Composition, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
            Padding="6,4">
        <DockPanel>

            <!-- Rien de tout ça n'a de sens sans source choisie. -->
            <StackPanel Orientation="Horizontal" Spacing="2"
                        IsEnabled="{Binding #PreviewRoot.Composition.HasSelection, FallbackValue=False}">
                <Button Classes="composition-tool" Content="Centrer" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.CenterSelected}"
                        ToolTip.Tip="Centrer dans le canvas"/>
                <Button Classes="composition-tool" Content="Ajuster" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.FitSelected}"
                        ToolTip.Tip="Ajuster au canvas"/>
                <Button Classes="composition-tool" Content="Réinitialiser" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.ResetTransform}"
                        ToolTip.Tip="Réinitialiser la transformation"/>
                <Rectangle Classes="composition-tool-separator"/>
                <Button Classes="composition-tool" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.RotateLeft}"
                        ToolTip.Tip="Pivoter de 90° à gauche"/>
                <Button Classes="composition-tool" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.RotateRight}"
                        ToolTip.Tip="Pivoter de 90° à droite"/>
                <Button Classes="composition-tool" Content="Rogner" Click="OnToolClick"
                        Classes.active="{Binding #PreviewRoot.Composition.IsCropMode, FallbackValue=False}"
                        Tag="{x:Static scenes:CompositionCommand.ToggleCrop}"
                        ToolTip.Tip="Rogner / terminer le rognage"/>
                <Rectangle Classes="composition-tool-separator"/>
                <Button Classes="composition-tool" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.BringToFront}"
                        ToolTip.Tip="Mettre au premier plan"/>
                <Button Classes="composition-tool" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.BringForward}"
                        ToolTip.Tip="Rapprocher du premier plan"/>
                <Button Classes="composition-tool" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.SendBackward}"
                        ToolTip.Tip="Reculer vers l'arrière-plan"/>
                <Button Classes="composition-tool" Click="OnToolClick"
                        Tag="{x:Static scenes:CompositionCommand.SendToBack}"
                        ToolTip.Tip="Mettre à l'arrière-plan"/>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
</UserControl>
