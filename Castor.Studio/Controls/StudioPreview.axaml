<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Controls.StudioPreview"
             x:Name="PreviewRoot"
             x:DataType="controls:StudioPreview"
             Focusable="True"
             KeyDown="OnPictureKeyDown"
             KeyUp="OnPictureKeyUp">
    <!-- Le pointeur ne peut pas atterrir sur la surface native : elle se déclare
         transparente aux tests de survol, et l'hôte ne teste pas le survol. Il tombe donc
         ici, sur le fond, qui le ramène dans le repère du canvas. -->
    <Panel x:Name="Picture"
           Background="Black"
           PointerPressed="OnPicturePointerPressed"
           PointerMoved="OnPicturePointerMoved"
           PointerReleased="OnPicturePointerReleased"
           PointerCaptureLost="OnPicturePointerCaptureLost"
           PointerExited="OnPicturePointerExited">
        <controls:ObsPreviewHost x:Name="NativePreview"
                                 IsHitTestVisible="False"
                                 Scene="{Binding #PreviewRoot.Scene}"
                                 Runtime="{Binding #PreviewRoot.PreviewRuntime}"
                                 Composition="{Binding #PreviewRoot.Composition}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

        <StackPanel IsVisible="{Binding #NativePreview.ShowPlaceholder}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="APERÇU"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VideoFgBrush}"
                       FontSize="13" FontWeight="Bold" LetterSpacing="2"/>
            <TextBlock Text="{Binding #PreviewRoot.Message}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VideoFgMutedBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" />
            <TextBlock Text="{Binding #NativePreview.ErrorMessage}"
                       IsVisible="{Binding #NativePreview.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource VideoErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" />
        </StackPanel>
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="12" Padding="10,6" CornerRadius="5"
                IsVisible="{Binding #PreviewRoot.ShowSceneName}"
                Background="#AA0B0B12" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <TextBlock Text="{Binding #PreviewRoot.Scene.Name}"
                       Foreground="{DynamicResource VideoFgBrush}" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Ce que le geste en cours écrit, près du pointeur. Une fenêtre à elle, et non une
             couche de la page : c'est ce qui la laisse passer au-dessus de la surface native. -->
        <Popup x:Name="Readout"
               PlacementTarget="{Binding #Picture}"
               Placement="AnchorAndGravity"
               PlacementAnchor="TopLeft"
               PlacementGravity="BottomRight"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="False"
               IsLightDismissEnabled="False"
               IsHitTestVisible="False">
            <Border Padding="8,4" CornerRadius="5"
                    Background="{DynamicResource AppNavBadgeBg}"
                    BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1">
                <TextBlock x:Name="ReadoutText"
                           Foreground="{DynamicResource AppFg1}"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Popup>
    </Panel>
</UserControl>
