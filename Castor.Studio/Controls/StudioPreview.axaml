<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Controls.StudioPreview"
             x:Name="PreviewRoot"
             x:DataType="controls:StudioPreview">
    <Panel Background="Black">
        <controls:ObsPreviewHost x:Name="NativePreview"
                                 Scene="{Binding #PreviewRoot.Scene}"
                                 Runtime="{Binding #PreviewRoot.PreviewRuntime}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

        <StackPanel IsVisible="{Binding #NativePreview.ShowPlaceholder}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="APERÇU"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppFg5}"
                       FontSize="13" FontWeight="Bold" LetterSpacing="2"/>
            <TextBlock Text="{Binding #PreviewRoot.Message}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppFg4}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" />
            <TextBlock Text="{Binding #NativePreview.ErrorMessage}"
                       IsVisible="{Binding #NativePreview.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource StatusErrorBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="380" />
        </StackPanel>
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="12" Padding="10,6" CornerRadius="5"
                IsVisible="{Binding #PreviewRoot.Scene, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#AA0B0B12" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <TextBlock Text="{Binding #PreviewRoot.Scene.Name}"
                       Foreground="{DynamicResource AppFg3}" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Panel>
</UserControl>
