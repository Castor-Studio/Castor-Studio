<Project>
  <!-- Managed NuGet assemblies also carry normalized timestamps. Remove the
       previous LibObs copy so MSBuild cannot keep a different package version.
       Only when it differs from the packaged one: deleting it on every build
       failed whenever a running Castor Studio held it, even with nothing to
       update. -->
  <Target Name="RemoveStaleLibObsManagedAssembly"
          BeforeTargets="_CopyFilesMarkedCopyLocal"
          Condition="Exists('$(TargetDir)LibObs.dll')">
    <ItemGroup>
      <_LibObsManagedAssembly Include="@(ReferenceCopyLocalPaths)"
                              Condition="'%(Filename)%(Extension)' == 'LibObs.dll'" />
    </ItemGroup>

    <GetFileHash Files="@(_LibObsManagedAssembly)" Algorithm="SHA256"
                 Condition="'@(_LibObsManagedAssembly)' != ''">
      <Output TaskParameter="Items" ItemName="_PackagedLibObsManagedAssembly" />
    </GetFileHash>
    <GetFileHash Files="$(TargetDir)LibObs.dll" Algorithm="SHA256"
                 Condition="'@(_LibObsManagedAssembly)' != ''">
      <Output TaskParameter="Items" ItemName="_DeployedLibObsManagedAssembly" />
    </GetFileHash>

    <PropertyGroup>
      <_PackagedLibObsManagedAssemblyHash>@(_PackagedLibObsManagedAssembly->'%(FileHash)')</_PackagedLibObsManagedAssemblyHash>
      <_DeployedLibObsManagedAssemblyHash>@(_DeployedLibObsManagedAssembly->'%(FileHash)')</_DeployedLibObsManagedAssemblyHash>
    </PropertyGroup>

    <Delete Files="$(TargetDir)LibObs.dll"
            Condition="'$(_PackagedLibObsManagedAssemblyHash)' != '' and '$(_PackagedLibObsManagedAssemblyHash)' != '$(_DeployedLibObsManagedAssemblyHash)'" />
  </Target>

  <!-- NuGet normalizes package timestamps, so PreserveNewest alone cannot replace
       a LibObs runtime left by a previous package version. Refresh the complete
       native payload whenever its packaged manifest changes. -->
  <Target Name="RemoveStaleLibObsRuntime"
          BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory"
          Condition="Exists('$(TargetDir)obs-runtime\runtime-manifest.json')">
    <ItemGroup>
      <_LibObsRuntimeManifest Include="@(Content)"
                              Condition="'%(Content.Link)' == 'obs-runtime\runtime-manifest.json'" />
    </ItemGroup>

    <GetFileHash Files="@(_LibObsRuntimeManifest)" Algorithm="SHA256"
                 Condition="'@(_LibObsRuntimeManifest)' != ''">
      <Output TaskParameter="Items" ItemName="_PackagedLibObsRuntimeManifest" />
    </GetFileHash>
    <GetFileHash Files="$(TargetDir)obs-runtime\runtime-manifest.json" Algorithm="SHA256"
                 Condition="'@(_LibObsRuntimeManifest)' != ''">
      <Output TaskParameter="Items" ItemName="_DeployedLibObsRuntimeManifest" />
    </GetFileHash>

    <PropertyGroup>
      <_PackagedLibObsRuntimeManifestHash>@(_PackagedLibObsRuntimeManifest->'%(FileHash)')</_PackagedLibObsRuntimeManifestHash>
      <_DeployedLibObsRuntimeManifestHash>@(_DeployedLibObsRuntimeManifest->'%(FileHash)')</_DeployedLibObsRuntimeManifestHash>
    </PropertyGroup>

    <RemoveDir Directories="$(TargetDir)obs-runtime"
               Condition="'$(_PackagedLibObsRuntimeManifestHash)' != '' and '$(_PackagedLibObsRuntimeManifestHash)' != '$(_DeployedLibObsRuntimeManifestHash)'" />
    <Delete Files="$(TargetDir)obs-ffmpeg-mux.exe"
            Condition="'$(_PackagedLibObsRuntimeManifestHash)' != '' and '$(_PackagedLibObsRuntimeManifestHash)' != '$(_DeployedLibObsRuntimeManifestHash)'" />
  </Target>
</Project>
