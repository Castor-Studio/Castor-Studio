<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Castor.AI, LibObs. Credentials: GITHUB_ACTOR / GITHUB_TOKEN (PAT with read:packages locally,
         the workflow GITHUB_TOKEN in CI). Never commit a token here. -->
    <add key="castor-github" value="https://nuget.pkg.github.com/Castor-Studio/index.json" />
  </packageSources>
</configuration>
